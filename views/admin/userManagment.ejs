<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management - KAVOX Admin</title>
  <script src="/js/notifications.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/shimmer.js"></script>
</head>

<body class="admin-layout">

  <%- include('partials/sidebar', { activePage: 'users' }) %>

    <!-- Main Content -->
    <main class="main-content">
      <header class="header">
        <h1>USER MANAGEMENT</h1>
      </header>

      <div class="content-wrapper">
        <!-- Standardized Search and Filter Card -->
        <div class="card" style="margin-bottom: 32px; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
          <div class="search-bar-container" style="display: flex; align-items: center; gap: 12px; width: 100%;">
            <div class="search-input-wrapper" style="flex: 1; max-width: 600px;">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
              <input type="text" class="form-control" placeholder="Search by name or email..." id="searchInput" style="height: 42px;">
            </div>
            <select class="form-control filter-select" id="filterSelect" onchange="filterUsers(this.value)" style="flex: 0 0 200px; height: 42px;">
              <option value="all" <%=typeof currentFilter !=='undefined' && currentFilter==='all' ? 'selected' : '' %>>All Users</option>
              <option value="active" <%=typeof currentFilter !=='undefined' && currentFilter==='active' ? 'selected' : '' %>>Active Only</option>
              <option value="blocked" <%=typeof currentFilter !=='undefined' && currentFilter==='blocked' ? 'selected' : '' %>>Blocked Only</option>
            </select>
          </div>
        </div>

        <!-- Users Table Card -->
        <div class="card" style="padding: 0;">
          <div class="table-wrapper">
            <table class="users-table">
              <thead>
                <tr>
                  <th>USERS ID</th>
                  <th>USERS</th>
                  <th>EMAIL</th>
                  <th>PHONE</th>
                  <th>JOINED ON</th>
                  <th>STATUS</th>
                  <th>ACTION</th>
                </tr>
              </thead>
              <tbody id="userTableBody">
                <% if (typeof users !=='undefined' && users.length> 0) { %>
                  <% users.forEach(function(user) { %>
                    <tr>
                      <td title="<%= user.id %>">
                        <%= user.id.toString().substring(0, 10) %>...
                      </td>
                      <td>
                        <div class="user-cell">
                          <span class="user-name">
                            <%= user.name %>
                          </span>
                        </div>
                      </td>
                      <td class="user-email">
                        <%= user.email %>
                      </td>
                      <td>
                        <%= user.phone %>
                      </td>
                      <td>
                        <%= user.joinedOn %>
                      </td>
                      <td>
                        <span class="<%= user.blocked ? 'status-blocked' : 'status-active' %>">
                          <%= user.blocked ? 'Blocked' : 'Active' %>
                        </span>
                      </td>
                      <td>
                        <div class="action-btns">
                          <a href="/admin/users/<%= user.id %>" class="btn-view" title="View Details">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                          </a>

                          <label class="switch">
                            <input type="checkbox" <%=!user.blocked ? 'checked' : '' %>
                            onchange="confirmToggleBlock('<%= user.id %>', this.checked)">
                              <span class="slider"></span>
                          </label>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="7" style="text-align: center; padding: 40px; color: #666;">
                            <div style="font-size: 16px; margin-bottom: 10px;">
                              No <%= typeof currentFilter !=='undefined' && currentFilter !=='all' ? currentFilter : ''
                                %> users found
                            </div>
                            <p style="font-size: 13px;">There are currently no users matching this criteria.</p>
                          </td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div class="pagination">
            <% if (currentPage> 1) { %>
              <a href="?page=<%= currentPage - 1 %>&status=<%= currentFilter %>">&laquo;</a>
              <% } %>

                <% for (let i=1; i <=totalPages; i++) { %>
                  <a href="?page=<%= i %>&status=<%= currentFilter %>" class="<%= currentPage === i ? 'active' : '' %>">
                    <%= i %>
                  </a>
                  <% } %>

                    <% if (currentPage < totalPages) { %>
                      <a href="?page=<%= currentPage + 1 %>&status=<%= currentFilter %>">&raquo;</a>
                      <% } %>
          </div>
        </div>
    </main>
    <script src="/js/notifications.js"></script>
    <script>
      function filterUsers(status) {
        const search = document.getElementById('searchInput').value;
        window.location.href = `/admin/users?status=${status}&search=${encodeURIComponent(search)}&page=1`;
      }

      async function confirmToggleBlock(userId, isActivating) {
        const action = isActivating ? 'unblock' : 'block';
        const checkbox = event.target;
        const switchLabel = checkbox.closest('.switch');

        const confirm = await KavoxNotify.confirm({
          title: `Are you sure?`,
          text: `You are about to ${action} this user.`,
          icon: 'warning',
          confirmText: `Yes, ${action}!`
        });

        if (confirm.isConfirmed) {
          switchLabel.classList.add('switch-loading');
          checkbox.disabled = true;
          try {
            const response = await fetch(`/api/admin/users/${userId}/${action}`, {
              method: 'PATCH',
              headers: { 'Accept': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
              KavoxNotify.toast(data.message, 'success');
              setTimeout(() => {
                location.reload();
              }, 1000);
            } else {
              KavoxNotify.alert({ title: 'Error', text: data.message || 'Action failed', icon: 'error' });
              checkbox.checked = !isActivating;
            }
          } catch (err) {
            console.error('Toggle Block Error:', err);
            KavoxNotify.toast('An internal error occurred', 'error');
            checkbox.checked = !isActivating;
          } finally {
            checkbox.disabled = false;
            switchLabel.classList.remove('switch-loading');
          }
        } else {
          checkbox.checked = !isActivating;
        }
      }

      // Modern Backend Search Implementation
      const searchInput = document.getElementById('searchInput');
      const tableBody = document.querySelector('.users-table tbody');
      const pagination = document.querySelector('.pagination');
      let searchTimeout = null;

      searchInput.addEventListener('input', function (e) {
        const searchTerm = e.target.value;
        const status = document.getElementById('filterSelect').value;

        clearTimeout(searchTimeout);

        searchTimeout = setTimeout(() => {
          performUserSearch(searchTerm, status);
        }, 300); // 300ms debounce
      });

      function showTableSkeleton() {
        const skeletonHTML = Array(5).fill(0).map(() => `
          <tr class="skeleton-row">
            <td><div class="skeleton" style="height: 12px; width: 60px;"></div></td>
            <td>
              <div class="user-cell">
                <div class="skeleton" style="height: 12px; width: 100px;"></div>
              </div>
            </td>
            <td><div class="skeleton" style="height: 12px; width: 150px;"></div></td>
            <td><div class="skeleton" style="height: 12px; width: 100px;"></div></td>
            <td><div class="skeleton" style="height: 12px; width: 80px;"></div></td>
            <td><div class="skeleton skeleton-pill"></div></td>
            <td><div class="skeleton" style="height: 12px; width: 60px; margin: 0 auto;"></div></td>
          </tr>
        `).join('');
        tableBody.innerHTML = skeletonHTML;
        tableBody.style.opacity = '1';
        pagination.style.opacity = '0.5';
        pagination.style.pointerEvents = 'none';
      }

      async function performUserSearch(search, status) {
        showTableSkeleton();
        try {
          const [response] = await Promise.all([
            fetch(`/admin/users?search=${encodeURIComponent(search)}&status=${status}`, {
              headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            }),
            new Promise(resolve => setTimeout(resolve, 400)) // Artificial delay for shimmer visibility
          ]);

          const data = await response.json();

          if (data.success) {
            tableBody.classList.remove('fade-in');
            void tableBody.offsetWidth; // Force reflow
            tableBody.classList.add('fade-in');
            renderUserTable(data.users);
            updatePagination(data.currentPage, data.totalPages, status, search);
            pagination.style.opacity = '1';
            pagination.style.pointerEvents = 'auto';
          }
        } catch (err) {
          console.error('Admin Search Error:', err);
        }
      }

      function renderUserTable(users) {
        if (users.length === 0) {
          tableBody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; padding: 40px; color: #666;">
              No users found matching your search.
            </td>
          </tr>
        `;
          return;
        }

        tableBody.innerHTML = users.map(user => `
        <tr>
          <td title="${user.id}">${user.id.toString().substring(0, 10)}...</td>
          <td>
            <div class="user-cell">
              <span class="user-name">${user.name}</span>
            </div>
          </td>
          <td class="user-email">${user.email}</td>
          <td>${user.phone}</td>
          <td>${user.joinedOn}</td>
          <td>
            <span class="${user.blocked ? 'status-blocked' : 'status-active'}">
              ${user.blocked ? 'Blocked' : 'Active'}
            </span>
          </td>
          <td>
            <div class="action-btns">
              <a href="/admin/users/${user.id}" class="btn-view" title="View Details">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              <label class="switch">
                <input type="checkbox" ${!user.blocked ? 'checked' : ''} 
                       onchange="confirmToggleBlock('${user.id}', this.checked)">
                <span class="slider"></span>
              </label>
            </div>
          </td>
        </tr>
      `).join('');
      }

      function updatePagination(currentPage, totalPages, status, search) {
        let html = '';
        if (currentPage > 1) {
          html += `<a href="?page=${currentPage - 1}&status=${status}&search=${encodeURIComponent(search)}">&laquo;</a>`;
        }
        for (let i = 1; i <= totalPages; i++) {
          html += `<a href="?page=${i}&status=${status}&search=${encodeURIComponent(search)}" class="${currentPage === i ? 'active' : ''}">${i}</a>`;
        }
        if (currentPage < totalPages) {
          html += `<a href="?page=${currentPage + 1}&status=${status}&search=${encodeURIComponent(search)}">&raquo;</a>`;
        }
        pagination.innerHTML = html;
      }
    </script>
</body>

</html>