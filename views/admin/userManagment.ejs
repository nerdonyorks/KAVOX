<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management - KAVOX Admin</title>
  <!-- SweetAlert2 -->
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.all.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #1a1a1a;
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
      width: 100%;
    }

    /* Sidebar */
    .sidebar {
      width: 160px;
      background-color: #000;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 100;
    }

    .logo {
      padding: 15px;
      border-bottom: 1px solid #333;
      text-align: center;
    }

    .logo-img {
      height: 40px;
      filter: invert(0);
    }

    .logo-sub {
      font-size: 10px;
      color: #4ade80;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .nav-menu {
      flex: 1;
      padding: 20px 0;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 15px;
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      transition: background-color 0.2s;
    }

    .nav-item:hover {
      background-color: #333;
    }

    .nav-item.active {
      background-color: #4ade80;
      color: #000;
    }

    .nav-icon {
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logout-section {
      padding: 20px 15px;
      border-top: 1px solid #333;
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      background: none;
      border: none;
      cursor: pointer;
    }

    .logout-btn:hover {
      color: #4ade80;
    }

    /* Mobile Menu Toggle */
    .menu-toggle {
      display: none;
      position: fixed;
      top: 15px;
      left: 15px;
      z-index: 1001;
      background: #000;
      border: none;
      color: #fff;
      padding: 10px;
      cursor: pointer;
      border-radius: 5px;
    }

    .overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 999;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      margin-left: 160px;
      background-color: #1a1a1a;
      min-width: 0;
      overflow-x: hidden;
      width: calc(100% - 160px);
    }

    .header {
      background-color: #374151;
      padding: 20px 30px;
    }

    .header h1 {
      color: #fff;
      font-size: 18px;
      font-weight: 500;
      letter-spacing: 1px;
    }

    .content {
      padding: 25px 30px;
      max-width: 100%;
      overflow-x: hidden;
    }

    /* Search and Filter */
    .search-filter {
      display: flex;
      justify-content: flex-end;
      gap: 15px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .search-input {
      padding: 10px 15px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 13px;
      width: 200px;
      background-color: #fff;
    }

    .filter-select {
      padding: 10px 15px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 13px;
      background-color: #fff;
      cursor: pointer;
      min-width: 100px;
    }

    /* Users Table */
    .users-section {
      background-color: #fff;
      border-radius: 8px;
      padding: 20px;
      max-width: 100%;
      overflow: hidden;
    }

    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .users-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }

    .users-table th {
      text-align: left;
      padding: 15px 12px;
      font-size: 11px;
      font-weight: 600;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid #eee;
    }

    .users-table td {
      padding: 15px 12px;
      font-size: 13px;
      color: #333;
      border-bottom: 1px solid #f5f5f5;
      vertical-align: middle;
    }

    .users-table tbody tr:hover {
      background-color: #fafafa;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      background-color: #ddd;
    }

    .user-name {
      font-weight: 500;
    }

    /* Toggle Switch */
    .switch {
      position: relative;
      display: inline-block;
      width: 46px;
      height: 24px;
    }

    .switch input { 
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #ef4444; /* Red for blocked */
      transition: .4s;
      border-radius: 24px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: .4s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: #22c55e; /* Green for active */
    }

    input:checked + .slider:before {
      transform: translateX(22px);
    }

    .btn-block {
      display: none; /* Hide old buttons */
    }

    .status-active {
      color: #22c55e;
      font-weight: 600;
    }

    .status-blocked {
      color: #ef4444;
      font-weight: 600;
    }

    .avatar-initial {
      width: 38px;
      height: 38px;
      background-color: #f3f4f6;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: #6b7280;
      font-size: 14px;
      border: 1px solid #e5e7eb;
    }

    .action-btns {
      display: flex;
      gap: 8px;
    }

    .btn-view {
      padding: 6px 12px;
      border-radius: 4px;
      border: 1px solid #e5e7eb;
      background-color: #fff;
      color: #374151;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    .btn-view:hover {
      background-color: #f9fafb;
    }

    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 25px;
      flex-wrap: wrap;
    }

    .pagination a,
    .pagination span {
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 4px;
      text-decoration: none;
      color: #333;
      font-size: 13px;
      transition: all 0.2s;
    }

    .pagination a:hover {
      background-color: #f5f5f5;
    }

    .pagination .active {
      background-color: #000;
      color: #fff;
      border-color: #000;
    }

    .pagination .ellipsis {
      border: none;
      padding: 8px 4px;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .menu-toggle {
        display: block;
      }

      .sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }

      .sidebar.active {
        transform: translateX(0);
      }

      .overlay.active {
        display: block;
      }

      .main-content {
        margin-left: 0;
        width: 100%;
      }

      .header {
        padding: 15px 20px;
        padding-left: 60px;
      }

      .content {
        padding: 15px;
      }

      .search-filter {
        justify-content: stretch;
      }

      .search-input {
        flex: 1;
        width: auto;
        min-width: 150px;
      }

      .users-section {
        padding: 15px;
      }

      .users-table th,
      .users-table td {
        padding: 12px 10px;
        font-size: 12px;
      }

      .user-avatar {
        width: 28px;
        height: 28px;
      }

      .btn-block {
        padding: 5px 12px;
        font-size: 10px;
      }
    }

    @media (max-width: 480px) {
      .header {
        padding: 12px 15px;
        padding-left: 55px;
      }

      .header h1 {
        font-size: 16px;
      }

      .content {
        padding: 12px;
      }

      .search-filter {
        flex-direction: column;
      }

      .search-input,
      .filter-select {
        width: 100%;
      }

      .users-section {
        padding: 10px;
      }

      .users-table th,
      .users-table td {
        padding: 10px 8px;
        font-size: 11px;
      }

      .user-cell {
        gap: 6px;
      }

      .user-avatar {
        width: 24px;
        height: 24px;
      }

      .pagination a,
      .pagination span {
        padding: 6px 10px;
        font-size: 12px;
      }
    }
  </style>
</head>
<body>
  <!-- Mobile Menu Toggle -->
  <button class="menu-toggle" onclick="toggleSidebar()">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <!-- Overlay -->
  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="logo">
      <img src="/images/logo.png" alt="KAVOX" class="logo-img">
      <div class="logo-sub">SOLE LAB</div>
    </div>

    <nav class="nav-menu">
      <a href="/admin/dashboard" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
        </span>
        Dashboard
      </a>
      <a href="/admin/users" class="nav-item active">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
          </svg>
        </span>
        Users
      </a>
      <a href="/admin/products" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 6h-4V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8-2h4v2h-4V4z"></path>
          </svg>
        </span>
        Products
      </a>
      <a href="/admin/categories" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l-5.5 9h11L12 2zm0 3.84L13.93 9h-3.87L12 5.84zM17.5 13c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zm0 7c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5zM3 21.5h8v-8H3v8zm2-6h4v4H5v-4z"></path>
          </svg>
        </span>
        Categories
      </a>
      <a href="/admin/banners" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5-7l-3 3.72L9 13l-3 4h12l-4-5z"></path>
          </svg>
        </span>
        Add Banners
      </a>
      <a href="/admin/coupons" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"></path>
          </svg>
        </span>
        Coupons
      </a>
      <a href="/admin/orders" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"></path>
          </svg>
        </span>
        Orders
      </a>
      <a href="/admin/report" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"></path>
          </svg>
        </span>
        Report
      </a>
    </nav>

    <div class="logout-section">
      <a href="/api/auth/logout" class="logout-btn">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"></path>
        </svg>
        Logout
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <header class="header">
      <h1>USER MANAGEMENT</h1>
    </header>

    <div class="content">
      <!-- Search and Filter -->
      <div class="search-filter">
        <input type="text" class="search-input" placeholder="Search Users........" id="searchInput">
        <select class="filter-select" id="filterSelect" onchange="filterUsers(this.value)">
          <option value="all" <%= typeof currentFilter !== 'undefined' && currentFilter === 'all' ? 'selected' : '' %>>All Users</option>
          <option value="active" <%= typeof currentFilter !== 'undefined' && currentFilter === 'active' ? 'selected' : '' %>>Active</option>
          <option value="blocked" <%= typeof currentFilter !== 'undefined' && currentFilter === 'blocked' ? 'selected' : '' %>>Blocked</option>
        </select>
      </div>

      <!-- Users Table -->
      <div class="users-section">
        <div class="table-wrapper">
          <table class="users-table">
            <thead>
              <tr>
                <th>USERS ID</th>
                <th>USERS</th>
                <th>EMAIL</th>
                <th>PHONE</th>
                <th>JOINED ON</th>
                <th>STATUS</th>
                <th>ACTION</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof users !== 'undefined' && users.length > 0) { %>
                <% users.forEach(function(user) { %>
                  <tr>
                    <td><%= user.id %></td>
                    <td>
                      <div class="user-cell">
                        <% if (user.avatar && user.avatar !== '/images/default-avatar.png') { %>
                          <img src="<%= user.avatar %>" alt="<%= user.name %>" class="user-avatar">
                        <% } else { %>
                          <div class="avatar-initial">
                            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                          </div>
                        <% } %>
                        <span class="user-name"><%= user.name %></span>
                      </div>
                    </td>
                    <td><%= user.email %></td>
                    <td><%= user.phone %></td>
                    <td><%= user.joinedOn %></td>
                    <td>
                      <span class="<%= user.blocked ? 'status-blocked' : 'status-active' %>">
                        <%= user.blocked ? 'Blocked' : 'Active' %>
                      </span>
                    </td>
                    <td>
                      <div class="action-btns">
                        <a href="/admin/users/view/<%= user.id %>" class="btn-view">VIEW</a>
                        
                        <label class="switch">
                          <input type="checkbox" <%= !user.blocked ? 'checked' : '' %> 
                                 onchange="confirmToggleBlock('<%= user.id %>', this.checked)">
                          <span class="slider"></span>
                        </label>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" style="text-align: center; padding: 40px; color: #666;">
                    <div style="font-size: 16px; margin-bottom: 10px;">
                      No <%= typeof currentFilter !== 'undefined' && currentFilter !== 'all' ? currentFilter : '' %> users found
                    </div>
                    <p style="font-size: 13px;">There are currently no users matching this criteria.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&status=<%= currentFilter %>">&laquo;</a>
          <% } %>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>&status=<%= currentFilter %>" class="<%= currentPage === i ? 'active' : '' %>"><%= i %></a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&status=<%= currentFilter %>">&raquo;</a>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <script>
    function filterUsers(status) {
      window.location.href = `/admin/users?status=${status}&page=1`;
    }

    function confirmToggleBlock(userId, isActivating) {
      const action = isActivating ? 'unblock' : 'block';
      const color = isActivating ? '#22c55e' : '#ef4444';
      
      Swal.fire({
        title: `Are you sure?`,
        text: `You are about to ${action} this user.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: color,
        cancelButtonColor: '#6b7280',
        confirmButtonText: `Yes, ${action}!`
      }).then((result) => {
        if (result.isConfirmed) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/admin/users/${action}/${userId}`;
          document.body.appendChild(form);
          form.submit();
        } else {
          // Revert toggle if cancelled
          location.reload();
        }
      });
    }

    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    }

    // Close sidebar when clicking outside on mobile
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768) {
        document.getElementById('sidebar').classList.remove('active');
        document.getElementById('overlay').classList.remove('active');
      }
    });

    // Search functionality
    document.getElementById('searchInput').addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase();
      const rows = document.querySelectorAll('.users-table tbody tr');
      
      rows.forEach(row => {
        // Find the user name and email within the row
        const name = row.querySelector('.user-name')?.textContent.toLowerCase() || "";
        const email = row.cells[2]?.textContent.toLowerCase() || "";
        const phone = row.cells[3]?.textContent.toLowerCase() || "";
        
        if (name.includes(searchTerm) || email.includes(searchTerm) || phone.includes(searchTerm)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  </script>
</body>
</html>
