<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KAVOX - Admin Login</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/shimmer.js"></script>
  <style>
    body {
      background-color: #f5f5f5;
      display: flex;
      flex-direction: column;
      font-family: Arial, sans-serif;
    }

    .header {
      background-color: #1a1a1a;
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logo-container {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .logo-img {
      height: 30px;
      transition: var(--transition);
    }

    .logo-subtitle {
      font-size: 11px;
      color: #4ade80;
      letter-spacing: 6.5px;
      font-weight: 800;
      margin-top: 4px;
    }

    .admin-title-bar {
      background-color: #f4f4f4;
      padding: 14px;
      text-align: center;
      font-size: 13px;
      color: #666;
      font-weight: 700;
      letter-spacing: 2px;
      border-bottom: 1px solid #ddd;
    }

    .main-container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 60px 20px;
    }

    .login-box {
      background-color: #ffffff;
      border: 1px solid #ddd;
      padding: 30px 40px 40px;
      width: 100%;
      max-width: 400px;
      border-radius: 10px;
    }

    .login-title {
      text-align: center;
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 30px;
      color: #333;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      color: #333;
      margin-bottom: 8px;
    }

    .form-input {
      width: 100%;
      padding: 12px 14px;
      background: #ffffff;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-input:focus {
      border-color: #e91e63;
    }

    .password-wrapper {
      position: relative;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #666;
      background: none;
      border: none;
      padding: 4px;
      display: flex;
      align-items: center;
      transition: color 0.2s;
    }

    .toggle-password:hover {
      color: #333;
    }

    .login-btn {
      width: 100%;
      margin-top: 20px;
      padding: 14px;
      background-color: #e91e63;
      color: #ffffff;
      border: 1px solid #e91e63;
      border-radius: 25px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s, border-color 0.2s;
      text-align: center;
    }

    .login-btn:hover {
      background-color: #c2185b;
      border-color: #c2185b;
    }

    .login-btn:active {
      transform: translateY(0);
    }
  </style>
  <script src="/js/shimmer.js"></script>
</head>

<body class="admin-layout">
  <header class="header">
    <div class="logo-container">
      <img src="/images/logo.png" alt="KAVOX" class="logo-img">
      <div class="logo-subtitle">SOLE LAB</div>
    </div>
  </header>


  <main class="main-container">
    <div class="login-box">
      <h1 class="login-title">Admin Log In</h1>

      <% if (typeof error !=='undefined' && error) { %>
        <div class="badge badge-error"
          style="width: 100%; text-align: center; margin-bottom: 24px; padding: 12px; border-radius: var(--radius-sm);">
          <%= error %>
        </div>
        <% } %>

          <form action="/admin/login" method="POST">
            <div class="form-group">
              <label class="form-label">Username</label>
              <input type="text" name="username" id="username" class="form-input">
              <div id="usernameError" class="error-msg"
                style="color: var(--error); font-size: 12px; margin-top: 8px; display: none; font-weight: 600;"></div>
            </div>

            <div class="form-group">
              <label class="form-label">Password</label>
              <div class="password-wrapper">
                <input type="password" name="password" id="password" class="form-input">
                <button type="button" class="toggle-password" onclick="togglePasswordVisibility('password', this)">
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
              </div>
              <div id="passwordError" class="error-msg"
                style="color: var(--error); font-size: 12px; margin-top: 8px; display: none; font-weight: 600;"></div>
            </div>

            <button type="submit" class="login-btn">Secure Login</button>
          </form>
    </div>
  </main>

  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('svg');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
      } else {
        input.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
      }
    }

    document.querySelector('form').addEventListener('submit', async function (e) {
      e.preventDefault();

      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value.trim();

      // Clear previous errors
      document.querySelectorAll('.error-msg').forEach(el => {
        el.textContent = '';
        el.style.display = 'none';
      });
      document.querySelectorAll('.form-input').forEach(el => el.style.borderColor = '#ccc');

      let hasError = false;
      if (!username) {
        const err = document.getElementById('usernameError');
        err.textContent = 'Username is required';
        err.style.display = 'block';
        document.getElementById('username').style.borderColor = '#e91e63';
        hasError = true;
      }
      if (!password) {
        const err = document.getElementById('passwordError');
        err.textContent = 'Password is required';
        err.style.display = 'block';
        document.getElementById('password').style.borderColor = '#e91e63';
        hasError = true;
      }

      if (hasError) return;

      const submitBtn = document.querySelector('.login-btn');
      submitBtn.classList.add('skeleton');
      submitBtn.disabled = true;

      try {
        const response = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await response.json();

        if (data.success) {
          window.location.href = data.redirect;
        } else {
          // Show general error or field error
          const err = document.getElementById('usernameError');
          err.textContent = data.error || 'Login failed';
          err.style.display = 'block';
          document.getElementById('username').style.borderColor = '#e91e63';
        }
      } catch (error) {
        console.error('Login Error:', error);
      } finally {
        submitBtn.classList.remove('skeleton');
        submitBtn.disabled = false;
      }
    });
  </script>
</body>

</html>