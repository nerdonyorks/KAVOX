<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KAVOX - Admin Login</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      min-height: 100vh;
    }

    .header {
      background-color: #1a1a1a;
      padding: 20px;
      text-align: center;
    }

    .logo-container {
      text-align: center;
    }

    .logo-img {
      height: 40px;
      filter: brightness(1) invert(0);
    }

    .logo-subtitle {
      font-size: 12px;
      color: #4ade80;
      letter-spacing: 4px;
      margin-top: 4px;
    }

    .admin-title {
      background-color: #e5e5e5;
      padding: 12px;
      text-align: center;
      font-size: 14px;
      color: #666;
      letter-spacing: 1px;
    }

    .main-container {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 40px 20px;
    }

    .login-card {
      background-color: #ffffff;
      border: 1px solid #ddd;
      padding: 30px 40px;
      width: 100%;
      max-width: 400px;
    }

    .login-title {
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 30px;
      color: #333;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 11px;
      color: #666;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .form-label .required {
      color: #e91e63;
    }

    .form-input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ccc;
      font-size: 14px;
      outline: none;
    }

    .form-input:focus {
      border-color: #e91e63;
    }

    .password-toggle-group {
      position: relative;
      display: flex;
      align-items: center;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      cursor: pointer;
      color: #666;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      padding: 0;
      outline: none;
      transition: color 0.1s;
    }

    .toggle-password:hover {
      color: #333;
    }

    .toggle-password svg {
      width: 18px;
      height: 18px;
    }

    .login-btn {
      width: 60%;
      display: block;
      margin: 30px auto 0;
      padding: 12px;
      background-color: #e91e63;
      color: #ffffff;
      border: none;
      font-size: 14px;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .login-btn:hover {
      background-color: #c2185b;
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="logo-container">
      <img src="/images/logo.png" alt="KAVOX" class="logo-img">
      <div class="logo-subtitle">SOLE LAB</div>
    </div>
  </header>

  <div class="admin-title">ADMIN LOGIN</div>

  <main class="main-container">
    <div class="login-card">
      <h1 class="login-title">Log In</h1>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background-color: #fee2e2; color: #dc2626; padding: 10px; border-radius: 4px; margin-bottom: 20px; font-size: 13px; text-align: center; border: 1px solid #fecaca;">
            <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div class="form-group">
          <label class="form-label">USERNAME <span class="required">*</span></label>
          <input type="text" name="username" id="username" class="form-input">
          <div id="usernameError" class="error-msg" style="color: #e91e63; font-size: 11px; margin-top: 4px; display: none;"></div>
        </div>

        <div class="form-group">
          <label class="form-label">PASSWORD <span class="required">*</span></label>
          <div class="password-toggle-group">
            <input type="password" name="password" id="password" class="form-input">
            <button type="button" class="toggle-password" onclick="togglePasswordVisibility('password', this)">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <div id="passwordError" class="error-msg" style="color: #e91e63; font-size: 11px; margin-top: 4px; display: none;"></div>
        </div>

        <button type="submit" class="login-btn">Log In</button>
      </form>
    </div>
  </main>
  
  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('svg');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
      } else {
        input.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
      }
    }

    document.querySelector('form').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value.trim();
      
      // Clear previous errors
      document.querySelectorAll('.error-msg').forEach(el => {
        el.textContent = '';
        el.style.display = 'none';
      });
      document.querySelectorAll('.form-input').forEach(el => el.style.borderColor = '#ccc');
      
      let hasError = false;
      if (!username) {
        const err = document.getElementById('usernameError');
        err.textContent = 'Username is required';
        err.style.display = 'block';
        document.getElementById('username').style.borderColor = '#e91e63';
        hasError = true;
      }
      if (!password) {
        const err = document.getElementById('passwordError');
        err.textContent = 'Password is required';
        err.style.display = 'block';
        document.getElementById('password').style.borderColor = '#e91e63';
        hasError = true;
      }
      
      if (hasError) return;
      
      try {
        const response = await fetch('/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        
        const data = await response.json();
        
        if (data.success) {
          window.location.href = data.redirect;
        } else {
          // Show general error or field error
          const err = document.getElementById('usernameError');
          err.textContent = data.error || 'Login failed';
          err.style.display = 'block';
          document.getElementById('username').style.borderColor = '#e91e63';
        }
      } catch (error) {
        console.error('Login Error:', error);
      }
    });
  </script>
</body>
</html>
