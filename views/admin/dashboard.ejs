<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - KAVOX Admin</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #1a1a1a;
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
      width: 100%;
    }

    /* Sidebar */
    .sidebar {
      width: 160px;
      background-color: #000;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 100;
    }

    .logo {
      padding: 15px;
      border-bottom: 1px solid #333;
      text-align: center;
    }

    .logo-img {
      height: 40px;
      filter: brightness(1) invert(0);
      
    }

    .logo-sub {
      font-size: 10px;
      color: #4ade80;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .nav-menu {
      flex: 1;
      padding: 20px 0;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 15px;
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      transition: background-color 0.2s;
    }

    .nav-item:hover {
      background-color: #333;
    }

    .nav-item.active {
      background-color: #4ade80;
      color: #000;
    }

    .nav-icon {
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logout-section {
      padding: 20px 15px;
      border-top: 1px solid #333;
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      background: none;
      border: none;
      cursor: pointer;
    }

    .logout-btn:hover {
      color: #4ade80;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      margin-left: 160px;
      background-color: #1a1a1a;
      min-width: 0;
      overflow-x: hidden;
      width: calc(100% - 160px);
    }

    .header {
      background-color: #374151;
      padding: 20px 30px;
    }

    .header h1 {
      color: #fff;
      font-size: 18px;
      font-weight: 500;
      letter-spacing: 1px;
    }

    .content {
      padding: 25px 30px;
      max-width: 100%;
      overflow-x: hidden;
    }

    /* Stats Cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background-color: #fff;
      border-radius: 8px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .stat-info h3 {
      font-size: 22px;
      font-weight: bold;
      color: #000;
    }

    .stat-info p {
      font-size: 11px;
      color: #666;
      margin-top: 2px;
    }

    .stat-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
    }

    .stat-icon.revenue {
      color: #4ade80;
    }

    .stat-icon.orders {
      color: #4ade80;
    }

    .stat-icon.products {
      color: #4ade80;
    }

    .stat-icon.customers {
      color: #4ade80;
    }

    /* Recent Orders */
    .orders-section {
      background-color: #fff;
      border-radius: 8px;
      padding: 20px;
      max-width: 100%;
      overflow: hidden;
    }

    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .orders-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .orders-header h2 {
      font-size: 16px;
      font-weight: 600;
      color: #000;
    }

    .view-all {
      color: #666;
      text-decoration: none;
      font-size: 13px;
    }

    .view-all:hover {
      color: #000;
    }

    .orders-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 500px;
    }

    .orders-table th {
      text-align: left;
      padding: 12px 15px;
      font-size: 12px;
      font-weight: 600;
      color: #000;
      border-bottom: 1px solid #e5e5e5;
    }

    .orders-table td {
      padding: 15px;
      font-size: 13px;
      color: #333;
      border-bottom: 1px solid #f0f0f0;
    }

    .status {
      font-size: 12px;
      font-weight: 500;
    }

    .status.completed {
      color: #4ade80;
    }

    .status.pending {
      color: #f97316;
    }

    /* Mobile Menu Toggle */
    .menu-toggle {
      display: none;
      position: fixed;
      top: 15px;
      left: 15px;
      z-index: 200;
      background-color: #000;
      border: none;
      color: #fff;
      padding: 10px;
      border-radius: 5px;
      cursor: pointer;
    }

    .overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 90;
    }

    /* Responsive Styles */
    @media (max-width: 1024px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .menu-toggle {
        display: block;
      }

      .sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }

      .sidebar.active {
        transform: translateX(0);
      }

      .overlay.active {
        display: block;
      }

      .main-content {
        margin-left: 0;
        width: 100%;
      }

      .header {
        padding: 15px 20px;
        padding-left: 60px;
      }

      .content {
        padding: 15px;
      }

      .stats-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }

      .stat-card {
        padding: 15px;
      }

      .orders-section {
        padding: 15px;
      }

      .orders-table th,
      .orders-table td {
        white-space: nowrap;
        padding: 10px 8px;
        font-size: 12px;
      }
    }

    @media (max-width: 480px) {
      .header {
        padding: 12px 15px;
        padding-left: 55px;
      }

      .header h1 {
        font-size: 14px;
      }

      .content {
        padding: 12px;
      }

      .stat-card {
        padding: 12px;
        gap: 10px;
      }

      .stat-info h3 {
        font-size: 16px;
      }

      .stat-info p {
        font-size: 10px;
      }

      .stat-icon {
        width: 32px;
        height: 32px;
      }

      .stat-icon svg {
        width: 24px;
        height: 24px;
      }

      .orders-section {
        padding: 12px;
      }

      .orders-header h2 {
        font-size: 14px;
      }

      .orders-table th,
      .orders-table td {
        padding: 8px 6px;
        font-size: 11px;
      }
    }
  </style>
</head>
<body>
  <!-- Mobile Menu Toggle -->
  <button class="menu-toggle" onclick="toggleSidebar()">
    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 12h18M3 6h18M3 18h18"></path>
    </svg>
  </button>

  <!-- Overlay -->
  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="logo">
      <img src="/images/logo.png" alt="KAVOX" class="logo-img">
      <div class="logo-sub">SOLE LAB</div>
    </div>

    <nav class="nav-menu">
      <a href="/admin/dashboard" class="nav-item active">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
        </span>
        Dashboard
      </a>
      <a href="/admin/users" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
          </svg>
        </span>
        Users
      </a>
      <a href="/admin/products" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 6h-4V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8-2h4v2h-4V4z"></path>
          </svg>
        </span>
        Products
      </a>
      <a href="/admin/categories" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l-5.5 9h11L12 2zm0 3.84L13.93 9h-3.87L12 5.84zM17.5 13c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zm0 7c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5zM3 21.5h8v-8H3v8zm2-6h4v4H5v-4z"></path>
          </svg>
        </span>
        Categories
      </a>
      <a href="/admin/banners" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5-7l-3 3.72L9 13l-3 4h12l-4-5z"></path>
          </svg>
        </span>
        Add Banners
      </a>
      <a href="/admin/coupons" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"></path>
          </svg>
        </span>
        Coupons
      </a>
      <a href="/admin/orders" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"></path>
          </svg>
        </span>
        Orders
      </a>
      <a href="/admin/report" class="nav-item">
        <span class="nav-icon">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"></path>
          </svg>
        </span>
        Report
      </a>
    </nav>

    <div class="logout-section">
      <a href="/api/auth/logout" class="logout-btn">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"></path>
        </svg>
        Logout
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <header class="header">
      <h1>ADMIN DASHBOARD</h1>
    </header>

    <div class="content">
      <!-- Stats Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-info">
            <h3><%= typeof totalRevenue !== 'undefined' ? '₹' + totalRevenue.toLocaleString() : '₹45,551' %></h3>
            <p>Total Revenue</p>
          </div>
          <div class="stat-icon revenue">
            <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"></path>
            </svg>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-info">
            <h3><%= typeof totalOrders !== 'undefined' ? totalOrders : '328' %></h3>
            <p>Orders</p>
          </div>
          <div class="stat-icon orders">
            <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
              <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"></path>
            </svg>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-info">
            <h3><%= typeof totalProducts !== 'undefined' ? totalProducts.toLocaleString() : '1,524' %></h3>
            <p>Products</p>
          </div>
          <div class="stat-icon products">
            <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z"></path>
            </svg>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-info">
            <h3><%= typeof totalCustomers !== 'undefined' ? totalCustomers : '922' %></h3>
            <p>Customers</p>
          </div>
          <div class="stat-icon customers">
            <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Recent Orders -->
      <div class="orders-section">
        <div class="orders-header">
          <h2>Recent Orders</h2>
          <a href="/orders" class="view-all">View All</a>
        </div>

        <div class="table-wrapper">
          <table class="orders-table">
            <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Date</th>
              <th>Total</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
              <% orders.forEach(function(order) { %>
                <tr>
                  <td>#<%= order.id %></td>
                  <td><%= order.customer %></td>
                  <td><%= order.date %></td>
                  <td>Rs.<%= order.total.toLocaleString() %></td>
                  <td><span class="status <%= order.status.toLowerCase() %>"><%= order.status %></span></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td>#011</td>
                <td>Hans Burger</td>
                <td>12/02/2026</td>
                <td>Rs.2,999.00</td>
                <td><span class="status completed">Completed</span></td>
              </tr>
              <tr>
                <td>#012</td>
                <td>Rullia Joberts</td>
                <td>12/02/2026</td>
                <td>Rs.3,999.00</td>
                <td><span class="status pending">Pending</span></td>
              </tr>
            <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    }

    // Close sidebar when clicking outside on mobile
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768) {
        document.getElementById('sidebar').classList.remove('active');
        document.getElementById('overlay').classList.remove('active');
      }
    });
  </script>
</body>
</html>
