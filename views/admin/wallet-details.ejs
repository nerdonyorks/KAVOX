<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/notifications.js"></script>
  <script src="/js/shimmer.js"></script>
  <style>
    /* Styling for Admin Wallet Details */
    .admin-wallet-grid {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 25px;
    }

    .stat-badge {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .stat-badge-label {
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .stat-badge-value {
      font-size: 22px;
      font-weight: 800;
      color: #0f172a;
    }

    .stat-badge-value.credit {
      color: #059669;
    }

    .stat-badge-value.debit {
      color: #dc2626;
    }

    .back-btn-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #475569;
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 20px;
      transition: color 0.15s ease;
    }

    .back-btn-link:hover {
      color: #0f172a;
    }

    .badge-tx {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .badge-tx.credit {
      background-color: #d1fae5;
      color: #065f46;
    }

    .badge-tx.debit {
      background-color: #fee2e2;
      color: #991b1b;
    }

    .form-group-custom {
      margin-bottom: 15px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group-custom label {
      font-size: 11px;
      font-weight: 700;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-group-custom input,
    .form-group-custom select {
      height: 40px;
      padding: 0 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 14px;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .form-group-custom input:focus,
    .form-group-custom select:focus {
      border-color: #2563eb;
    }

    .btn-submit-adjust {
      width: 100%;
      height: 42px;
      background: var(--primary-color, #1e293b);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: background 0.15s ease;
      margin-top: 10px;
    }

    .btn-submit-adjust:hover {
      background: #0f172a;
    }
  </style>
</head>

<body class="admin-layout">

  <%- include('partials/sidebar', { activePage: 'wallets' }) %>

  <main class="main-content">
    <header class="header">
      <h1>WALLET LEDGER DETAILS</h1>
    </header>

    <div class="content-wrapper">
      
      <!-- Back Link -->
      <a href="/admin/wallets" class="back-btn-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Wallets Listing
      </a>

      <!-- Page Grid -->
      <div class="admin-wallet-grid">
        
        <!-- User Details Card -->
        <div class="card" style="padding: 25px;">
          <h2 style="font-size: 18px; font-weight: 800; color: #1e293b; margin-bottom: 20px;">CUSTOMER WALLET SUMMARY</h2>
          
          <div style="display: flex; gap: 40px; margin-bottom: 25px; border-bottom: 1px solid #f1f5f9; padding-bottom: 20px;">
            <div>
              <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Customer Name</div>
              <div id="customerName" style="font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 4px;">Loading...</div>
            </div>
            <div>
              <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Email Address</div>
              <div id="customerEmail" style="font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 4px;">Loading...</div>
            </div>
            <div>
              <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Mobile Phone</div>
              <div id="customerPhone" style="font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 4px;">Loading...</div>
            </div>
          </div>

          <div class="info-grid">
            <div class="stat-badge">
              <span class="stat-badge-label">Available Balance</span>
              <span id="availableBalance" class="stat-badge-value">₹0.00</span>
            </div>
            <div class="stat-badge">
              <span class="stat-badge-label">Total Credits</span>
              <span id="totalCredits" class="stat-badge-value credit">₹0.00</span>
            </div>
            <div class="stat-badge">
              <span class="stat-badge-label">Total Debits</span>
              <span id="totalDebits" class="stat-badge-value debit">₹0.00</span>
            </div>
          </div>
        </div>

        <!-- Transaction Ledger Card -->
        <div class="card" style="padding: 0; overflow: hidden;">
          <div style="padding: 20px 25px; border-bottom: 1px solid #f1f5f9;">
            <h2 style="font-size: 15px; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px; margin: 0;">TRANSACTION LOG</h2>
          </div>
          
          <div class="table-wrapper">
            <table class="users-table">
              <thead>
                <tr>
                  <th>Date & Time</th>
                  <th>Type</th>
                  <th>Ref Order</th>
                  <th>Reason / Details</th>
                  <th style="text-align: right;">Amount</th>
                </tr>
              </thead>
              <tbody id="transactionTableBody">
                <tr>
                  <td colspan="5" style="text-align: center; padding: 40px; color: #64748b;">
                    Loading transactions...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </main>

  <script>
    const userId = "<%= userId %>";

    function getDescriptionText(desc) {
      if (desc === 'ORDER_CANCELLATION_REFUND') return 'Order Cancellation Refund';
      if (desc === 'RETURN_REFUND') return 'Product Return Refund';
      if (desc === 'WALLET_PAYMENT') return 'Purchase Checkout Deduction';
      if (desc === 'ADMIN_ADJUSTMENT') return 'Admin Manual Adjustment';
      return desc || '';
    }

    async function loadWalletDetails() {
      try {
        const response = await fetch(window.location.pathname, {
          headers: {
            'Accept': 'application/json'
          }
        });
        const data = await response.json();

        if (data.success) {
          // Update User Details
          document.getElementById('customerName').innerText = data.targetUser.name;
          document.getElementById('customerEmail').innerText = data.targetUser.email;
          document.getElementById('customerPhone').innerText = data.targetUser.phone || 'N/A';

          // Update Wallet Metrics
          document.getElementById('availableBalance').innerText = '₹' + Number(data.wallet.balance).toFixed(2);
          document.getElementById('totalCredits').innerText = '₹' + Number(data.wallet.totalCredits || 0).toFixed(2);
          document.getElementById('totalDebits').innerText = '₹' + Number(data.wallet.totalDebits || 0).toFixed(2);

          // Render Transactions Table
          const tbody = document.getElementById('transactionTableBody');
          tbody.innerHTML = '';

          if (data.transactions && data.transactions.length > 0) {
            data.transactions.forEach(tx => {
              const dateStr = formatDateTime(tx.createdAt);
              const badgeClass = tx.type.toLowerCase();
              const orderLink = tx.orderId 
                ? (tx.orderDocId 
                    ? `<a href="/admin/order/${tx.orderDocId}" style="color: #2563eb; font-weight: bold; text-decoration: none;">${tx.orderId}</a>`
                    : `<span style="font-family: monospace; font-weight: 600;">${tx.orderId}</span>`)
                : '<span style="color: #94a3b8;">—</span>';
              
              const descText = getDescriptionText(tx.description);
              const sign = tx.type === 'CREDIT' ? '+' : '-';
              const color = tx.type === 'CREDIT' ? '#059669' : '#dc2626';

              tbody.innerHTML += `
                <tr>
                  <td>${dateStr}</td>
                  <td><span class="badge-tx ${badgeClass}">${tx.type}</span></td>
                  <td>${orderLink}</td>
                  <td>${descText}</td>
                  <td style="text-align: right; font-weight: 700; font-size: 15px; color: ${color}">
                    ${sign}₹${Number(tx.amount).toFixed(2)}
                  </td>
                </tr>
              `;
            });
          } else {
            tbody.innerHTML = `
              <tr>
                <td colspan="5" style="text-align: center; padding: 40px; color: #64748b;">
                  No transactions found for this user.
                </td>
              </tr>
            `;
          }
        } else {
          KavoxNotify.toast(data.message || "Failed to load wallet details.", "error");
          renderErrorState();
        }
      } catch (error) {
        console.error("Fetch error:", error);
        KavoxNotify.toast("Connection error loading wallet details.", "error");
        renderErrorState();
      }
    }

    function renderErrorState() {
      const tbody = document.getElementById('transactionTableBody');
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align: center; padding: 40px; color: #dc2626; font-weight: bold;">
            Failed to load transaction history. Please refresh the page.
          </td>
        </tr>
      `;
    }

    document.addEventListener("DOMContentLoaded", loadWalletDetails);
  </script>

</body>

</html>
