<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Address - KAVOX SOLE LAB</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/notifications.js"></script>
    <script src="/js/shimmer.js"></script>
    <style>
        /* Main Content */
        .main-content {
            flex: 1;
            padding: 40px 20px;
            max-width: 1000px;
            width: 100%;
            margin: 0 auto;
        }

        /* Page Title */
        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #000;
            margin-bottom: 30px;
            text-decoration: underline;
            text-underline-offset: 6px;
        }

        /* Add New Address Card */
        .add-address-card {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 20px 25px;
            margin-bottom: 20px;
            cursor: pointer;
            transition: border-color 0.2s;
            background: #fff;
        }

        .add-address-card:hover {
            border-color: #999;
            background-color: #fafafa;
        }

        .add-address-text {
            font-size: 16px;
            font-weight: 500;
            color: #000;
        }

        /* Address Card */
        .address-card {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 20px 25px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            background: #fff;
        }

        .address-content {
            display: flex;
            gap: 12px;
            flex: 1;
        }

        .address-checkbox {
            width: 18px;
            height: 18px;
            border: 2px solid #333;
            border-radius: 2px;
            cursor: pointer;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .address-details {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .address-type {
            font-size: 15px;
            font-weight: 600;
            color: #000;
            margin-bottom: 4px;
        }

        .address-line {
            font-size: 14px;
            color: #333;
            line-height: 1.5;
        }

        .address-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

        .delete-btn {
            background: none;
            border: 1px solid #e91e63;
            color: #e91e63;
            padding: 8px 20px;
            border-radius: 4px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .delete-btn:hover {
            background-color: #e91e63;
            color: #fff;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .main-content {
                padding: 30px 20px;
            }

            .address-card {
                flex-direction: column;
                gap: 15px;
            }

            .address-actions {
                align-items: flex-start;
                width: 100%;
            }

            .delete-btn {
                width: 100%;
                text-align: center;
            }
        }

        @media (max-width: 480px) {
            .main-content {
                padding: 20px 15px;
            }

            .add-address-card,
            .address-card {
                padding: 15px;
            }
        }
    </style>
</head>

<body class="user-layout">
    <%- include('../partials/user-header') %>


        <!-- Main Content -->
        <main class="main-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
                <h1 class="page-title">ADDRESS</h1>
                <a href="<%= locals.returnTo ? returnTo : '/account' %>"
                    style="text-decoration: none; color: #e91e63; font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 5px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7" />
                    </svg>
                    <%= locals.returnTo ? 'BACK TO CHECKOUT' : 'BACK TO PROFILE' %>
                </a>
            </div>

            <!-- Add New Address -->
            <div class="add-address-card" onclick="window.location.href='/address/add<%= locals.returnTo ? '?returnTo=' + returnTo : '' %>'">
                <span class="add-address-text">ADD NEW ADDRESS</span>
            </div>

            <!-- Address List -->
            <% if (typeof addresses !=='undefined' && addresses.length> 0) { %>
                <% addresses.forEach(function(address, index) { %>
                    <div class="address-card">
                        <div class="address-content">
                            <input type="checkbox" class="address-checkbox" <%=address.isDefault ? 'checked' : '' %>
                            onchange="setDefaultAddress('<%= address._id %>')">
                                <div class="address-details">
                                    <span class="address-type">(<%= address.type || 'HOME' %>)</span>
                                    <span class="address-line">
                                        <%= address.street %>
                                    </span>
                                    <span class="address-line">
                                        <%= address.city %> - <%= address.pincode %>
                                    </span>
                                    <span class="address-line">
                                        <%= address.state %>
                                    </span>
                                    <span class="address-line">Mobile : <%= address.mobile %></span>
                                </div>
                        </div>
                        <div class="address-actions">
                            <button class="delete-btn" style="margin-bottom: 8px; border-color: #333; color: #333;"
                                onclick="window.location.href='/address/edit/<%= address._id %><%= locals.returnTo ? '?returnTo=' + returnTo : '' %>'">Edit Address</button>
                            <button class="delete-btn" onclick="deleteAddress('<%= address._id %>')">Delete
                                Address</button>
                        </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <div
                                style="text-align: center; padding: 40px; background: #fafafa; border-radius: 8px; border: 1px dashed #ccc;">
                                <p style="color: #888; margin-bottom: 20px;">No addresses saved yet.</p>

                            </div>
                            <% } %>
        </main>

        <%- include('../partials/user-footer') %>

            <script>


                async function deleteAddress(addressId) {
                    const confirmed = await KavoxNotify.confirm({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        confirmText: 'Yes, delete it!'
                    });

                    const isConfirmed = confirmed.isConfirmed;

                    if (isConfirmed) {
                        const mainContent = document.querySelector('.main-content');
                        mainContent.classList.add('is-loading-container');
                        try {
                            const [response] = await Promise.all([
                                fetch(`/api/users/addresses/${addressId}`, {
                                    method: 'DELETE',
                                    headers: { 'Accept': 'application/json' }
                                }),
                                new Promise(resolve => setTimeout(resolve, 600))
                            ]);

                            const data = await response.json();
                            if (data.success) {
                                await KavoxNotify.alert({ title: 'Deleted!', text: data.message, icon: 'success' });
                                window.location.reload();
                            } else {
                                mainContent.classList.remove('is-loading-container');
                                KavoxNotify.alert({ title: 'Error', text: data.message || 'Failed to delete address', icon: 'error' });
                            }
                        } catch (error) {
                            mainContent.classList.remove('is-loading-container');
                            console.error('Delete Address Error:', error);
                            KavoxNotify.alert({ title: 'Error', text: 'An internal error occurred', icon: 'error' });
                        }
                    }
                }

                async function setDefaultAddress(addressId) {
                    const mainContent = document.querySelector('.main-content');
                    mainContent.classList.add('is-loading-container');
                    try {
                        const [response] = await Promise.all([
                            fetch(`/api/users/addresses/${addressId}/default`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify({ isDefault: true })
                            }),
                            new Promise(resolve => setTimeout(resolve, 600))
                        ]);

                        const data = await response.json();
                        if (data.success) {
                            const returnUrl = '<%= locals.returnTo || "" %>';
                            if (returnUrl) {
                                window.location.href = returnUrl;
                            } else {
                                window.location.reload();
                            }
                        } else {
                            mainContent.classList.remove('is-loading-container');
                            KavoxNotify.alert({ title: 'Error', text: data.message || 'Failed to set default address', icon: 'error' });
                        }
                    } catch (error) {
                        mainContent.classList.remove('is-loading-container');
                        console.error('Set Default Address Error:', error);
                        KavoxNotify.alert({ title: 'Error', text: 'An internal error occurred', icon: 'error' });
                    }
                }
            </script>
</body>

</html>