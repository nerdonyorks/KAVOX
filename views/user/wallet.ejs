<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/shimmer.js"></script>
  <style>
    /* Custom styles for Wallet Dashboard to make it look premium and state-of-the-art */
    .wallet-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #fff;
      border-radius: 16px;
      padding: 35px;
      margin-bottom: 30px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }

    .wallet-hero::after {
      content: "";
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(233, 30, 99, 0.15) 0%, rgba(233, 30, 99, 0) 70%);
      pointer-events: none;
    }

    .wallet-hero-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 10px;
    }

    .wallet-hero-balance {
      font-size: 42px;
      font-weight: 800;
      letter-spacing: -1px;
      margin-bottom: 25px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .wallet-stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 25px;
    }

    .wallet-stat-card {
      display: flex;
      flex-direction: column;
    }

    .wallet-stat-label {
      font-size: 10px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 5px;
    }

    .wallet-stat-value {
      font-size: 20px;
      font-weight: 700;
    }

    .wallet-stat-value.credit {
      color: #34d399;
    }

    .wallet-stat-value.debit {
      color: #f87171;
    }

    .ledger-title {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin: 30px 0 20px;
      color: #1e293b;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 10px;
    }

    .ledger-table-container {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .ledger-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .ledger-table th {
      background: #f8fafc;
      padding: 16px 20px;
      font-size: 11px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid #e2e8f0;
    }

    .ledger-table td {
      padding: 16px 20px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      color: #334155;
    }

    .ledger-table tr:last-child td {
      border-bottom: none;
    }

    .tx-type-badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .tx-type-badge.credit {
      background-color: #d1fae5;
      color: #065f46;
    }

    .tx-type-badge.debit {
      background-color: #fee2e2;
      color: #991b1b;
    }

    .tx-amount {
      font-weight: 700;
      font-size: 15px;
    }

    .tx-amount.credit {
      color: #059669;
    }

    .tx-amount.debit {
      color: #dc2626;
    }

    .tx-order-link {
      color: #2563eb;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .tx-order-link:hover {
      color: #1d4ed8;
      text-decoration: underline;
    }

    .tx-empty-state {
      padding: 50px 20px;
      text-align: center;
      color: #64748b;
    }

    .tx-empty-state svg {
      width: 60px;
      height: 60px;
      stroke: #cbd5e1;
      margin-bottom: 15px;
    }

    .back-profile-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 25px;
      transition: color 0.2s ease;
    }

    .back-profile-link:hover {
      color: #0f172a;
    }
  </style>
</head>

<body class="user-layout">
  <%- include('../partials/user-header') %>

  <!-- Main Content -->
  <main class="main-content">
    <div class="profile-container">
      
      <!-- Back to Profile link -->
      <a href="/account" class="back-profile-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Profile
      </a>

      <!-- Wallet Hero Card -->
      <div class="wallet-hero">
        <div>
          <div class="wallet-hero-label">Available Balance</div>
          <div class="wallet-hero-balance">
            <span>₹</span><%= Number(wallet.balance).toFixed(2) %>
          </div>
        </div>

        <div class="wallet-stats-grid">
          <div class="wallet-stat-card">
            <span class="wallet-stat-label">Total Credits</span>
            <span class="wallet-stat-value credit">₹<%= Number(wallet.totalCredits || 0).toFixed(2) %></span>
          </div>
          <div class="wallet-stat-card">
            <span class="wallet-stat-label">Total Debits</span>
            <span class="wallet-stat-value debit">₹<%= Number(wallet.totalDebits || 0).toFixed(2) %></span>
          </div>
        </div>
      </div>

      <!-- Transaction History -->
      <h2 class="ledger-title">TRANSACTION LEDGER</h2>
      
      <div class="ledger-table-container">
        <% if (transactions && transactions.length > 0) { %>
          <table class="ledger-table">
            <thead>
              <tr>
                <th>Date & Time</th>
                <th>Type</th>
                <th>Description</th>
                <th>Ref Order</th>
                <th style="text-align: right;">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(tx => { %>
                <tr>
                  <td>
                    <%= new Date(tx.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                  </td>
                  <td>
                    <span class="tx-type-badge <%= tx.type.toLowerCase() %>"><%= tx.type %></span>
                  </td>
                  <td style="font-weight: 500;">
                    <% if (tx.description === 'ORDER_CANCELLATION_REFUND') { %>
                      Order Cancellation Refund
                    <% } else if (tx.description === 'RETURN_REFUND') { %>
                      Product Return Refund
                    <% } else if (tx.description === 'WALLET_PAYMENT') { %>
                      Wallet Purchase Deduction
                    <% } else if (tx.description === 'ADMIN_ADJUSTMENT') { %>
                      Account Balance Adjustment
                    <% } else { %>
                      <%= tx.description.replace(/_/g, ' ') %>
                    <% } %>
                  </td>
                  <td>
                    <% if (tx.orderId) { %>
                      <% if (tx.orderDocId) { %>
                        <a href="/order/<%= tx.orderDocId %>" class="tx-order-link"><%= tx.orderId %></a>
                      <% } else { %>
                        <span style="font-family: monospace; font-weight: 600;"><%= tx.orderId %></span>
                      <% } %>
                    <% } else { %>
                      <span style="color: #94a3b8;">—</span>
                    <% } %>
                  </td>
                  <td class="tx-amount <%= tx.type.toLowerCase() %>" style="text-align: right;">
                    <%= tx.type === 'CREDIT' ? '+' : '-' %>₹<%= Number(tx.amount).toFixed(2) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="tx-empty-state">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p style="font-weight: 600; margin-bottom: 5px;">No transactions recorded</p>
            <p style="font-size: 13px; color: #94a3b8;">When you receive refunds or make purchases via wallet, your transactions will appear here.</p>
          </div>
        <% } %>
      </div>

    </div>
  </main>

  <%- include('../partials/user-footer') %>
</body>

</html>
