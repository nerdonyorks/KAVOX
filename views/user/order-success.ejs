<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Success - KAVOX</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .success-container {
      max-width: 600px;
      margin: 80px auto;
      text-align: center;
      padding: 50px 40px;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    .success-img {
      width: 180px;
      height: 180px;
      margin: 0 auto 30px;
    }
    .success-img img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .success-title {
      font-size: 28px;
      font-weight: 800;
      color: #111;
      margin-bottom: 10px;
      letter-spacing: 1px;
    }
    .success-subtitle {
      font-size: 16px;
      font-weight: 600;
      color: #e91e63;
      margin-bottom: 15px;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .success-text {
      color: #666;
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 40px;
      padding: 0 20px;
    }
    .success-actions {
      display: flex;
      gap: 20px;
      justify-content: center;
    }
    .btn-secondary {
      background: #fff;
      color: #111;
      border: 2px solid #111;
      padding: 12px 24px;
      text-decoration: none;
      font-weight: 700;
      border-radius: 4px;
      text-transform: uppercase;
      transition: all 0.3s ease;
    }
    .btn-secondary:hover {
      background: #111;
      color: #fff;
    }
    .btn-primary {
      background: var(--accent-color);
      color: #fff;
      border: 2px solid var(--accent-color);
      padding: 12px 24px;
      text-decoration: none;
      font-weight: 700;
      border-radius: 4px;
      text-transform: uppercase;
      transition: all 0.3s ease;
    }
    .btn-primary:hover {
      background: #d81b60;
      border-color: #d81b60;
    }
  </style>
</head>
<body class="user-layout">
  <%- include('../partials/user-header') %>

  <main class="success-container">
    <div class="success-img">
      <img src="/images/order_success.png" alt="Order Success Illustration">
    </div>
    
    <h2 class="success-subtitle">Thank You!</h2>
    <h1 class="success-title">Your Order is Confirmed</h1>
    
    <p class="success-text">
      We've received your order 
      <% if (locals.orderId) { %>
        <strong>#<%= orderId %></strong>
      <% } %>
      and are getting it ready to be shipped. We will send you a confirmation email with tracking details once it ships.
    </p>

    <div class="success-actions">
      <!-- Pointing to account/orders for now, as order-details view is standard there -->
      <a href="/orders" class="btn-secondary">View Order Details</a>
      <a href="/shop" class="btn-primary">Continue Shopping</a>
    </div>
  </main>

  <%- include('../partials/user-footer') %>
</body>
</html>
