<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - KAVOX SOLE LAB</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/notifications.js"></script>
    <script src="/js/shimmer.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .otp-container {
            width: 100%;
            max-width: 700px;
            border: 1px solid #000000;
            padding: 60px 40px;
            text-align: center;
        }

        .logo {
            margin-bottom: 20px;
        }

        .logo-img {
            height: 40px;
            filter: invert(0);
        }


        .logo-text {
            font-size: 48px;
            font-weight: 900;
            color: #000000;
            letter-spacing: 2px;
            font-family: 'Arial Black', sans-serif;
        }

        /* Header Styles */
        .header {
            background-color: #1a1a1a;
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
            position: absolute;
            /* Lock to top for centered body layouts */
        }

        .header-logo-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .header-logo-img {
            height: 30px;
            filter: invert(0);
        }

        .header-logo-sub {
            font-size: 12px;
            color: #4ade80;
            letter-spacing: 6.5px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .nav-links a:hover {
            color: #4ade80;
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .header-icons a {
            color: #fff;
            display: flex;
            align-items: center;
        }

        .header-icons svg {
            width: 22px;
            height: 22px;
        }

        .sign-in-btn {
            background-color: #e91e63;
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
        }

        .sign-in-btn:hover {
            background-color: #c2185b;
        }

        .profile-mini {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background-color: #333;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #4ade80;
        }

        .profile-mini img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .logo-text .k {
            font-style: italic;
        }

        .logo-subtext {
            font-size: 14px;
            letter-spacing: 12px;
            color: #3333cc;
            font-weight: 600;
            margin-top: 5px;
        }

        .otp-title {
            font-size: 32px;
            font-weight: 700;
            color: #000000;
            margin-bottom: 15px;
        }

        .otp-subtitle {
            font-size: 16px;
            color: #000000;
            margin-bottom: 30px;
        }

        .otp-inputs {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
        }

        .otp-input {
            width: 70px;
            height: 45px;
            border: 1px solid #000000;
            border-radius: 25px;
            text-align: center;
            font-size: 20px;
            font-weight: 600;
            outline: none;
            transition: border-color 0.3s ease;
        }

        .otp-input:focus {
            border-color: #ff1e56;
        }

        .otp-separator {
            font-size: 24px;
            color: #000000;
            font-weight: 300;
        }

        .verify-btn {
            width: 100%;
            max-width: 280px;
            padding: 14px 0;
            background-color: #ff1e56;
            color: #ffffff;
            border: none;
            border-radius: 25px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin-bottom: 20px;
        }

        .verify-btn:hover {
            background-color: #e6194d;
        }

        .resend-text {
            font-size: 14px;
            color: #000000;
        }

        .resend-link {
            color: #3366cc;
            text-decoration: none;
            font-weight: 500;
        }

        .resend-link:hover {
            text-decoration: underline;
        }

        .error-message {
            background-color: #fee2e2;
            border: 1px solid #ef4444;
            color: #dc2626;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .success-message {
            background-color: #dcfce7;
            border: 1px solid #22c55e;
            color: #16a34a;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .otp-container {
                padding: 40px 20px;
            }

            .logo-text {
                font-size: 36px;
            }

            .logo-subtext {
                font-size: 12px;
                letter-spacing: 8px;
            }

            .otp-title {
                font-size: 26px;
            }

            .otp-input {
                width: 55px;
                height: 40px;
                font-size: 18px;
            }

            .otp-separator {
                font-size: 20px;
            }
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="header">
        <div class="header-logo-container">
            <img src="/images/logo.png" alt="KAVOX" class="header-logo-img">
            <span class="header-logo-sub">SOLE LAB</span>
        </div>

        <nav class="nav-links">
            <a href="/">HOME</a>
            <a href="/shop">SHOP</a>
            <a href="/orders">ORDERS</a>
        </nav>

        <div class="header-icons">
            <a href="/cart" title="Cart">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                </svg>
            </a>
            <a href="/wishlist" title="Wishlist">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                    </path>
                </svg>
            </a>
            <% if (locals.user) { %>
                <a href="/account" title="Account">
                    <% if (user.profileImage) { %>
                        <div class="profile-mini">
                            <img src="<%= user.profileImage %>" alt="Profile">
                        </div>
                        <% } else { %>
                            <div class="profile-mini">
                                <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <% } %>
                </a>
                <a href="/api/auth/logout" class="sign-in-btn" style="background-color: #333;">Logout</a>
                <% } else { %>
                    <a href="/login" class="sign-in-btn">Sign In</a>
                    <% } %>
        </div>
    </header>

    <div class="otp-container" style="margin-top: 80px;">
        <div class="logo">
            <img src="/images/logo.png" alt="KAVOX" class="logo-img">
            <div class="logo-subtitle">S O L E &nbsp;&nbsp; L A B</div>
        </div>

        <h1 class="otp-title">Enter OTP</h1>
        <p class="otp-subtitle">We have sent otp to your email address</p>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="error-message">
                <%= error %>
            </div>
            <% } %>

                <% if (typeof success !=='undefined' && success) { %>
                    <div class="success-message">
                        <%= success %>
                    </div>
                    <% } %>

                        <!-- AJAX error message div -->
                        <div id="ajaxErrorDiv" class="error-message" style="display: none; margin-bottom: 20px;"></div>

                        <form action="/verify-otp" method="POST" id="otpForm">
                            <!-- Read email from query params or passed variable, fallback to empty -->
                            <input type="hidden" name="email" id="userEmail"
                                value="<%= typeof email !== 'undefined' ? email : '' %>">
                            <input type="hidden" name="name" id="userName" value="">
                            <input type="hidden" name="referralCode" id="userReferral" value="">
                            <input type="hidden" name="type" id="flowType" value="">

                            <div class="otp-inputs">
                                <input type="text" class="otp-input" name="otp1" maxlength="1" pattern="[0-9]"
                                    inputmode="numeric"  autofocus>
                                <input type="text" class="otp-input" name="otp2" maxlength="1" pattern="[0-9]"
                                    inputmode="numeric" >
                                <input type="text" class="otp-input" name="otp3" maxlength="1" pattern="[0-9]"
                                    inputmode="numeric" >
                                <input type="text" class="otp-input" name="otp4" maxlength="1" pattern="[0-9]"
                                    inputmode="numeric" >

                            </div>
                            <div id="otpInputError" style="color: #ff1e56; font-size: 14px; margin-bottom: 20px; display: none;">Please enter the full 4-digit OTP.</div>

                            <button type="submit" class="verify-btn">Verify</button>
                        </form>

                        <p class="resend-text">
                            Didn't receive code? <a href="#" id="resendOtpBtn" class="resend-link"
                                style="pointer-events: none; color: #999;">Resend OTP</a>
                            <span id="timerText"
                                style="margin-left: 10px; font-weight: bold; color: #ff1e56;">(60s)</span>
                        </p>
    </div>

    <script>
        // Use a self-invoking function to avoid global namespace pollution and ensure clean initialization
        (function() {
            const urlParams = new URLSearchParams(window.location.search);
            const emailInput = document.getElementById('userEmail');
            const flowTypeInput = document.getElementById('flowType');
            const timerElement = document.getElementById('timerText');
            const resendBtn = document.getElementById('resendOtpBtn');
            const otpInputs = document.querySelectorAll('.otp-input');
            const inlineError = document.getElementById('ajaxErrorDiv');
            const inputFieldErrors = document.getElementById('otpInputError');
            
            // 1. Populate initial data from URL
            const emailFromUrl = urlParams.get('email');
            if (emailFromUrl && !emailInput.value) {
                emailInput.value = emailFromUrl;
            }

            const typeFromUrl = urlParams.get('type');
            if (typeFromUrl) {
                flowTypeInput.value = typeFromUrl;
            }

            const nameFromUrl = urlParams.get('name');
            if (nameFromUrl) document.getElementById('userName').value = nameFromUrl;

            const refFromUrl = urlParams.get('referralCode');
            if (refFromUrl) document.getElementById('userReferral').value = refFromUrl;

            // 2. Timer Setup
            const email = emailInput.value;
            const TIMER_DURATION = 60;
            const timerKey = `otp_timer_end_${email}`;
            
            let timerId;

            function updateTimerDisplay(time) {
                if (time > 0) {
                    timerElement.textContent = `(${time}s)`;
                    timerElement.style.display = 'inline';
                    resendBtn.style.pointerEvents = 'none';
                    resendBtn.style.color = '#999';
                } else {
                    timerElement.style.display = 'none';
                    resendBtn.style.pointerEvents = 'auto';
                    resendBtn.style.color = '#3366cc';
                    if (email) localStorage.removeItem(timerKey);
                    clearInterval(timerId);
                }
            }

            function startTimer(duration) {
                clearInterval(timerId);
                let finishTime = localStorage.getItem(timerKey);
                
                // If no finishTime exists in localStorage, this is a "fresh" arrival or resend
                if (!finishTime) {
                    finishTime = Date.now() + (duration * 1000);
                    if (email) localStorage.setItem(timerKey, finishTime);
                }

                const tick = () => {
                    const now = Date.now();
                    const remaining = Math.max(0, Math.floor((parseInt(finishTime) - now) / 1000));
                    updateTimerDisplay(remaining);
                    if (remaining <= 0) {
                        clearInterval(timerId);
                    }
                };

                tick(); // Run immediately to avoid 1s delay
                timerId = setInterval(tick, 1000);
            }

            // 3. Initialize Timer and UI
            if (email) {
                // If we have an email, start the 60s timer (it will resume if finishTime is in localStorage)
                startTimer(TIMER_DURATION);
            } else {
                updateTimerDisplay(0);
            }

            // 4. Resend Logic
            resendBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                const currentEmail = emailInput.value;
                if (!currentEmail) return;

                try {
                    const res = await fetch('/api/auth/resend-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: currentEmail })
                    });
                    const data = await res.json();
                    if (res.ok) {
                        KavoxNotify.toast('OTP resent to your email.', 'success');
                        localStorage.removeItem(timerKey); 
                        startTimer(TIMER_DURATION);
                    } else {
                        KavoxNotify.alert({ icon: 'error', title: 'Failed to Resend', text: data.message || 'Failed to resend OTP.' });
                    }
                } catch (err) {
                    KavoxNotify.toast('An error occurred while resending OTP.', 'error');
                }
            });

            // 5. Input Auto-focus & Paste Logic
            otpInputs.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    if (!/^\d*$/.test(e.target.value)) { e.target.value = ''; return; }
                    if (e.target.value.length === 1 && index < otpInputs.length - 1) otpInputs[index + 1].focus();
                });
                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !e.target.value && index > 0) otpInputs[index - 1].focus();
                });
                input.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const pastedData = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 4);
                    pastedData.split('').forEach((char, i) => { if (otpInputs[i]) otpInputs[i].value = char; });
                    if (pastedData.length > 0) otpInputs[Math.min(pastedData.length, otpInputs.length - 1)].focus();
                });
            });

            // 6. AJAX Verification Logic
            document.getElementById('otpForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const otp = Array.from(otpInputs).map(input => input.value).join('');
                const currentEmail = emailInput.value;
                const currentType = flowTypeInput.value;

                const ajaxErrorDiv = document.getElementById('ajaxErrorDiv');
                const otpInputError = document.getElementById('otpInputError');
                const submitBtn = document.querySelector('button[type="submit"]');

                ajaxErrorDiv.style.display = 'none';
                otpInputError.style.display = 'none';
                submitBtn.classList.add('btn-loading');
                submitBtn.disabled = true;

                if (otp.length < 4) { otpInputError.style.display = 'block'; submitBtn.classList.remove('btn-loading'); submitBtn.disabled = false; return; }

                try {
                    const response = await fetch('/api/auth/verify-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ email: currentEmail, otp, type: currentType })
                    });
                    const data = await response.json();
                    if (response.ok && data.success) {
                        window.location.href = data.redirect;
                    } else {
                        ajaxErrorDiv.textContent = data.message || 'Invalid or expired OTP. Please try again.';
                        ajaxErrorDiv.style.display = 'block';
                        otpInputs.forEach(input => input.value = '');
                        otpInputs[0].focus();
                    }
                } catch (err) {
                    ajaxErrorDiv.textContent = 'An error occurred during verification. Please try again.';
                    ajaxErrorDiv.style.display = 'block';
                } finally {
                    submitBtn.classList.remove('btn-loading');
                    submitBtn.disabled = false;
                }
            });
        })();
    </script>
</body>

</html>