<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - KAVOX SOLE LAB</title>
    <script src="/js/notifications.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/shimmer.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .card {
            border: 2px solid #000000;
            border-radius: 4px;
            padding: 50px 60px;
            width: 100%;
            max-width: 600px;
            text-align: center;
        }
        .logo-img {
      height: 40px;
      filter: invert(0);
    }


        .logo {
            margin-bottom: 20px;
        }

        .logo-main {
            font-size: 48px;
            font-weight: 900;
            color: #000000;
            letter-spacing: 2px;
            font-family: 'Arial Black', Arial, sans-serif;
            -webkit-text-stroke: 2px #000000;
            -webkit-text-fill-color: transparent;
        }

        .logo-sub {
            font-size: 14px;
            letter-spacing: 12px;
            color: #3344dd;
            font-weight: 600;
            margin-top: 2px;
        }

        .title {
            font-size: 32px;
            font-weight: 700;
            color: #000000;
            margin-bottom: 15px;
        }

        .description {
            font-size: 14px;
            color: #000000;
            margin-bottom: 25px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: #000000;
            margin-bottom: 8px;
        }

        .form-group label .required {
            color: #ff1744;
            margin-left: 2px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1.5px solid #000000;
            border-radius: 25px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus {
            border-color: #ff1744;
        }

        .submit-btn {
            width: 280px;
            padding: 14px;
            background: linear-gradient(to right, #ff1744, #ff4569);
            color: white;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            margin-bottom: 20px;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(255, 23, 68, 0.4);
        }

        .signin-link {
            font-size: 14px;
            color: #000000;
        }

        .signin-link a {
            color: #3344dd;
            text-decoration: none;
            font-weight: 500;
        }

        .signin-link a:hover {
            text-decoration: underline;
        }

        .error-message {
            display: none;
        }

        .success-message {
            display: none;
        }

        /* Header Styles */
        .header {
            background-color: #1a1a1a;
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
            position: absolute; /* Lock to top for centered body layouts */
        }

        .header-logo-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .header-logo-img {
            height: 30px;
            filter: invert(0);
        }

        .header-logo-sub {
            font-size: 12px;
            color: #4ade80;
            letter-spacing: 6.5px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .nav-links a:hover {
            color: #4ade80;
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .header-icons a {
            color: #fff;
            display: flex;
            align-items: center;
        }

        .header-icons svg {
            width: 22px;
            height: 22px;
        }

        .sign-in-btn {
            background-color: #e91e63;
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
        }

        .sign-in-btn:hover {
            background-color: #c2185b;
        }

        .profile-mini {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background-color: #333;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #4ade80;
        }

        .profile-mini img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        @media (max-width: 480px) {
            .card {
                padding: 30px 25px;
            }

            .logo-main {
                font-size: 36px;
            }

            .title {
                font-size: 24px;
            }

            .submit-btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-logo-container">
            <img src="/images/logo.png" alt="KAVOX" class="header-logo-img">
            <span class="header-logo-sub">SOLE LAB</span>
        </div>

        <nav class="nav-links">
            <a href="/">HOME</a>
            <a href="/shop">SHOP</a>
            <a href="/orders">ORDERS</a>
        </nav>

        <div class="header-icons">
            <a href="/cart" title="Cart">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                </svg>
            </a>
            <a href="/wishlist" title="Wishlist">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </a>
            <% if (locals.user) { %>
                <a href="/account" title="Account">
                    <% if (user.profileImage) { %>
                        <div class="profile-mini">
                            <img src="<%= user.profileImage %>" alt="Profile">
                        </div>
                    <% } else { %>
                        <div class="profile-mini">
                            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                    <% } %>
                </a>
                <a href="/api/auth/logout" class="sign-in-btn" style="background-color: #333;">Logout</a>
            <% } else { %>
                <a href="/login" class="sign-in-btn">Sign In</a>
            <% } %>
        </div>
    </header>

    <div class="card" style="margin-top: 80px;">
        <div class="logo">
            <img src="/images/logo.png" alt="KAVOX" class="logo-img">
      <div class="logo-subtitle">S O L E &nbsp;&nbsp; L A B</div>
        </div>

        <h1 class="title">Forgot Password ?</h1>
        
        <p class="description">Enter your email address and we'll send a link to reset password</p>

        <form id="forgotPasswordForm">
            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input type="email" name="email" id="email" placeholder="">
                <div id="emailError" class="error-msg" style="color: #ff1744; font-size: 12px; margin-top: 5px; display: none;"></div>
            </div>

            <button type="submit" class="submit-btn" id="submitBtn">Send Reset Link</button>
        </form>

        <div class="signin-link">
            Go to <a href="/login">Sign In</a>
        </div>
    </div>
    <script src="/js/notifications.js"></script>
    <script>
        const emailInput = document.getElementById('email');
        const emailError = document.getElementById('emailError');

        // Real-time clear
        emailInput.addEventListener('input', () => {
            emailError.textContent = '';
            emailError.style.display = 'none';
            emailInput.style.borderColor = '#000';
        });

        document.getElementById('forgotPasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const emailValue = emailInput.value.trim();
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.textContent;

            // Clear previous errors
            emailError.textContent = '';
            emailError.style.display = 'none';
            emailInput.style.borderColor = '#000';
            
            if (!emailValue) {
                emailError.textContent = 'Email is required';
                emailError.style.display = 'block';
                emailInput.style.borderColor = '#ff1744';
                return;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(emailValue)) {
                emailError.textContent = 'Please enter a valid email address';
                emailError.style.display = 'block';
                emailInput.style.borderColor = '#ff1744';
                return;
            }

            submitBtn.textContent = 'Sending...';
            submitBtn.disabled = true;

            try {
                const response = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: emailValue })
                });

                const data = await response.json();

                if (data.success) {
                    KavoxNotify.alert({
                        icon: 'success',
                        title: 'Email Sent',
                        text: data.message
                    });
                    emailInput.value = ''; // clear
                } else {
                    KavoxNotify.alert({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message
                    });
                }
            } catch (error) {
                KavoxNotify.alert({
                    icon: 'error',
                    title: 'System Error',
                    text: 'Unable to send password reset link at this time.'
                });
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
