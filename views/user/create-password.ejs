<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KAVOX - Create Password</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #fff;
      color: #333;
    }

    /* Header */
    .header {
      background-color: #1a1a1a;
      padding: 12px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .logo-img {
      height: 40px;
      filter: invert(0);
    }

    .logo-sub {
      font-size: 12px;
      color: #4ade80;
      letter-spacing: 4px;
    }

    .search-box {
      flex: 1;
      max-width: 400px;
      display: flex;
      align-items: center;
      background-color: #333;
      border-radius: 4px;
      padding: 8px 12px;
      gap: 10px;
    }

    .search-box input {
      flex: 1;
      background: none;
      border: none;
      outline: none;
      color: #fff;
      font-size: 13px;
    }

    .search-box input::placeholder {
      color: #888;
    }

    .search-box svg {
      color: #888;
      width: 18px;
      height: 18px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.5px;
    }

    .nav-links a:hover {
      color: #4ade80;
    }

    .header-icons {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .header-icons a {
      color: #fff;
      display: flex;
      align-items: center;
    }

    .header-icons svg {
      width: 22px;
      height: 22px;
    }

    .sign-in-btn {
      background-color: #e91e63;
      color: #fff;
      border: none;
      padding: 8px 18px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
    }

    .sign-in-btn:hover {
      background-color: #c2185b;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
    }
    
    .profile-mini {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background-color: #333;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid #4ade80;
    }
    
    .profile-mini img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }

    /* Main Content */
    .main-content {
      min-height: calc(100vh - 300px);
      padding: 60px 30px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .reset-card {
      width: 100%;
      max-width: 700px;
      border: 1px solid #ccc;
      border-radius: 8px;
      padding: 50px 60px;
      text-align: center;
    }

    .reset-logo {
      margin-bottom: 10px;
    }

    .reset-logo img {
      height: 80px;
    }

    .reset-logo-sub {
      font-size: 12px;
      letter-spacing: 10px;
      color: #1a1a1a;
      margin-bottom: 20px;
    }

    .reset-title {
      font-size: 32px;
      font-weight: 400;
      color: #1a1a1a;
      margin-bottom: 30px;
    }

    .form-group {
      text-align: left;
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 8px;
      letter-spacing: 0.5px;
    }

    .form-group input {
      width: 100%;
      padding: 12px 15px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 14px;
      outline: none;
      transition: border-color 0.3s;
    }

    .form-group input:focus {
      border-color: #e91e63;
    }

    .password-toggle-group {
      position: relative;
      display: flex;
      align-items: center;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      cursor: pointer;
      color: #666;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      padding: 0;
      outline: none;
      transition: color 0.1s;
    }

    .toggle-password:hover {
      color: #333;
    }

    .toggle-password svg {
      width: 18px;
      height: 18px;
    }

    .submit-btn {
      width: 60%;
      padding: 14px;
      background: linear-gradient(135deg, #e91e63 0%, #ff6b9d 100%);
      color: #fff;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      margin-top: 20px;
      transition: opacity 0.3s;
    }

    .submit-btn:hover {
      opacity: 0.9;
    }

    .error-message {
      background-color: #ffebee;
      color: #c62828;
      padding: 12px;
      border-radius: 4px;
      margin-bottom: 20px;
      font-size: 13px;
    }

    .success-message {
      background-color: #e8f5e9;
      color: #2e7d32;
      padding: 12px;
      border-radius: 4px;
      margin-bottom: 20px;
      font-size: 13px;
    }

    /* Footer */
    .footer {
      background-color: #1a1a1a;
      padding: 50px 30px 20px;
      color: #fff;
    }

    .footer-content {
      display: grid;
      grid-template-columns: 1fr 2fr 1fr;
      gap: 40px;
      max-width: 1200px;
      margin: 0 auto 30px;
    }

    .footer-logo {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-left: 20px;
    }

    .footer-logo .logo-img {
      height: 40px;
      filter: invert(0);
      margin-bottom: 5px;
    }

    .footer-logo .logo-sub {
      font-size: 10px;
      color: #fff;
      letter-spacing: 5px;
      text-align: center;
    }
    .logo-sub-footer {
      font-size: 14px;
      color: #4ade80;
      letter-spacing: 5px;
    }


    .footer-links {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .footer-links-column h4 {
      font-size: 12px;
      font-weight: 400;
      margin-bottom: 15px;
      color: #888;
    }

    .footer-links-column a {
      display: block;
      color: #ccc;
      text-decoration: none;
      font-size: 13px;
      margin-bottom: 10px;
    }

    .footer-links-column a:hover {
      color: #4ade80;
    }

    .footer-social h4 {
      font-size: 14px;
      margin-bottom: 15px;
    }

    .footer-social a {
      display: block;
      color: #ccc;
      text-decoration: none;
      font-size: 13px;
      margin-bottom: 10px;
    }

    .footer-social a:hover {
      color: #4ade80;
    }

    .footer-bottom {
      text-align: center;
      padding-top: 20px;
      border-top: 1px solid #333;
    }

    .footer-bottom p {
      font-size: 11px;
      color: #666;
    }

    /* Mobile Menu */
    .mobile-nav {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.95);
      z-index: 200;
      flex-direction: column;
      padding: 60px 30px;
    }

    .mobile-nav.active {
      display: flex;
    }

    .mobile-nav-close {
      position: absolute;
      top: 20px;
      right: 20px;
      background: none;
      border: none;
      color: #fff;
      font-size: 30px;
      cursor: pointer;
    }

    .mobile-nav a {
      color: #fff;
      text-decoration: none;
      font-size: 18px;
      padding: 15px 0;
      border-bottom: 1px solid #333;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .footer-links {
        justify-content: center;
      }
    }

    @media (max-width: 768px) {
      .header {
        padding: 12px 15px;
      }

      .search-box {
        display: none;
      }

      .nav-links {
        display: none;
      }

      .menu-toggle {
        display: block;
      }

      .main-content {
        padding: 30px 15px;
      }

      .reset-card {
        padding: 30px 20px;
      }

      .reset-title {
        font-size: 24px;
      }

      .submit-btn {
        width: 80%;
      }

      .footer {
        padding: 30px 15px 15px;
      }
    }

    @media (max-width: 480px) {
      .header-icons {
        gap: 12px;
      }

      .header-icons svg {
        width: 18px;
        height: 18px;
      }

      .sign-in-btn {
        padding: 6px 12px;
        font-size: 11px;
      }

      .reset-logo img {
        height: 60px;
      }

      .reset-title {
        font-size: 20px;
      }

      .submit-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="logo-container">
      <img src="/images/logo.png" alt="KAVOX" class="logo-img">
      <span class="logo-sub">S O L E &nbsp; L A B</span>
    </div>

    <div class="search-box">
      <input type="text" placeholder="Search for products, brands & more">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="M21 21l-4.35-4.35"></path>
      </svg>
    </div>

    <nav class="nav-links">
      <a href="/">HOME</a>
      <a href="/shop">SHOP</a>
      <a href="/orders">ORDERS</a>
    </nav>

    <div class="header-icons">
      <a href="/cart" title="Cart">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
        </svg>
      </a>
      <a href="/wishlist" title="Wishlist">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>
      <% if (locals.user) { %>
        <a href="/account" title="Account">
          <% if (user.profileImage) { %>
            <div class="profile-mini">
              <img src="<%= user.profileImage %>" alt="Profile">
            </div>
          <% } else { %>
            <div class="profile-mini">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
          <% } %>
        </a>
        <a href="/api/auth/logout" class="sign-in-btn" style="background-color: #333;">Logout</a>
      <% } else { %>
        <a href="/login" class="sign-in-btn">Sign In</a>
      <% } %>
    </div>

    <button class="menu-toggle" onclick="toggleMobileNav()">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </header>

  <!-- Mobile Navigation -->
  <div class="mobile-nav" id="mobileNav">
    <button class="mobile-nav-close" onclick="toggleMobileNav()">&times;</button>
    <a href="/">HOME</a>
    <a href="/shop">SHOP</a>
    <a href="/orders">ORDERS</a>
    <a href="/cart">CART</a>
    <a href="/wishlist">WISHLIST</a>
    <a href="/account">MY ACCOUNT</a>
    <a href="/login">SIGN IN</a>
  </div>

  <!-- Main Content -->
  <main class="main-content">
    <div class="reset-card">
      <div class="reset-logo">
        <img src="/images/logo.png" alt="KAVOX">
      </div>
      <p class="reset-logo-sub">S O L E &nbsp; &nbsp; L A B</p>
      <h1 class="reset-title">Create Password</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message"><%= success %></div>
      <% } %>

      <form action="/create-password" method="POST">
        <div class="form-group">
          <label for="newPassword">NEW PASSWORD</label>
          <div class="password-toggle-group">
            <input type="password" id="newPassword" name="newPassword" required>
            <button type="button" class="toggle-password" onclick="togglePasswordVisibility('newPassword', this)">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">RE-ENTER PASSWORD</label>
          <div class="password-toggle-group">
            <input type="password" id="confirmPassword" name="confirmPassword" required>
            <button type="button" class="toggle-password" onclick="togglePasswordVisibility('confirmPassword', this)">
              <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="submit-btn" style="width: 100%;">Complete Verification</button>
      </form>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-logo">
        <img src="/images/logo.png" alt="KAVOX" class="logo-img">
        <p class="logo-sub-footer">S O L E &nbsp; L A B</p>
      </div>

      <div class="footer-links">
        <div class="footer-links-column">
          <a href="/cancellation">Cancellation & Returns</a>
          <a href="/orders">orders</a>
          <a href="/">Home</a>
          <a href="/shop">Shope</a>
          <a href="/account">My Account</a>
        </div>
        <div class="footer-links-column">
          <h4>Payments</h4>
          <a href="/shipping">Shipping</a>
          <a href="/terms">Terms of Use</a>
          <a href="/security">Security</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>

      <div class="footer-social">
        <h4>Find us on social</h4>
        <a href="mailto:kavox@gmail.com">Email : kavox@gmail.com</a>
        <a href="#">Instagram</a>
        <a href="#">Facebook</a>
        <a href="#">Twiter</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Nonstop Fashion & Lifestyle</p>
      <p>All Rights Reserved</p>
    </div>
  </footer>

  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('svg');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
      } else {
        input.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
      }
    }

    function toggleMobileNav() {
      document.getElementById('mobileNav').classList.toggle('active');
    }
  </script>
</body>
</html>
