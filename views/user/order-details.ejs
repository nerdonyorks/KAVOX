<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/shimmer.js"></script>
    <link rel="stylesheet" href="/css/orders.css">
    <style>
        /* ── Order Status Timeline ───────────────────────── */
        .order-status-section {
            margin-top: 20px;
        }

        .order-status-section h6 {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .timeline-track {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .tl-step {
            display: flex;
            align-items: flex-start;
            gap: 18px;
            position: relative;
            padding-bottom: 28px;
        }

        .tl-step:last-child {
            padding-bottom: 0;
        }

        .tl-gutter {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 20px;
            flex-shrink: 0;
        }

        .tl-dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #cbd5e1;
            border: 3px solid #f1f5f9;
            position: relative;
            z-index: 2;
            flex-shrink: 0;
        }

        .tl-connector {
            width: 2px;
            flex: 1;
            min-height: 28px;
            background: #e2e8f0;
            margin-top: 2px;
        }

        .tl-body {
            padding-top: 0;
        }

        .tl-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: #94a3b8;
            line-height: 1.4;
        }

        .tl-desc {
            font-size: 0.78rem;
            color: #cbd5e1;
            margin-top: 3px;
        }

        /* ── Completed ─── */
        .tl-step.tl-done .tl-dot {
            background: #10b981;
            border-color: #d1fae5;
            box-shadow: 0 0 0 4px rgba(16,185,129,0.12);
        }
        .tl-step.tl-done .tl-connector { background: #10b981; }
        .tl-step.tl-done .tl-label { color: #0f172a; font-weight: 700; }
        .tl-step.tl-done .tl-desc  { color: #475569; }

        /* ── Partial (in-progress) ─── */
        .tl-step.tl-partial .tl-dot {
            background: #3b82f6;
            border-color: #dbeafe;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.12);
        }
        .tl-step.tl-partial .tl-connector {
            background: linear-gradient(to bottom, #3b82f6 40%, #e2e8f0 40%);
        }
        .tl-step.tl-partial .tl-label { color: #1d4ed8; font-weight: 700; }
        .tl-step.tl-partial .tl-desc  { color: #3b82f6; }

        /* ── Cancelled ─── */
        .tl-step.tl-cancelled .tl-dot {
            background: #ef4444;
            border-color: #fee2e2;
            box-shadow: 0 0 0 4px rgba(239,68,68,0.12);
        }
        .tl-step.tl-cancelled .tl-label { color: #dc2626; font-weight: 700; }
        .tl-step.tl-cancelled .tl-desc  { color: #f87171; }

        /* ── Return Requested ─── */
        .tl-step.tl-return-req .tl-dot {
            background: #f59e0b;
            border-color: #fef3c7;
            box-shadow: 0 0 0 4px rgba(245,158,11,0.12);
        }
        .tl-step.tl-return-req .tl-label { color: #d97706; font-weight: 700; }
        .tl-step.tl-return-req .tl-desc  { color: #fbbf24; }

        /* ── Returned ─── */
        .tl-step.tl-returned .tl-dot {
            background: #8b5cf6;
            border-color: #ede9fe;
            box-shadow: 0 0 0 4px rgba(139,92,246,0.12);
        }
        .tl-step.tl-returned .tl-label { color: #7c3aed; font-weight: 700; }
        .tl-step.tl-returned .tl-desc  { color: #a78bfa; }

        /* ── Return Approved ─── */
        .tl-step.tl-return-approved .tl-dot {
            background: #10b981;
            border-color: #d1fae5;
            box-shadow: 0 0 0 4px rgba(16,185,129,0.12);
        }
        .tl-step.tl-return-approved .tl-connector { background: #10b981; }
        .tl-step.tl-return-approved .tl-label { color: #059669; font-weight: 700; }
        .tl-step.tl-return-approved .tl-desc  { color: #10b981; }
    </style>
</head>
<body class="user-layout">
    <%- include('../partials/user-header') %>

    <main class="orders-container">
        <a href="/orders" class="back-link">&larr; BACK TO ORDERS</a>
        
        <div class="order-details-header">
            <h1 style="margin:0; font-size: 28px; font-weight: 800;">ORDER DETAILS</h1>
            <% if (['Delivered', 'Return Requested', 'Return Approved', 'Return Rejected', 'Returned'].includes(order.orderStatus) || order.items.some(i => ['Delivered', 'Return Requested', 'Return Approved', 'Return Rejected', 'Returned'].includes(i.itemStatus))) { %>
                <a href="/order/<%= order._id %>/invoice" class="btn-primary" target="_blank">DOWNLOAD INVOICE</a>
            <% } %>
        </div>

        <div class="order-details-layout">
            <!-- Left Column: Items and Status -->
            <div class="order-items-panel">
                <div class="order-details-card">
                    <div class="order-details-card-header">
                        <div>
                            <span>ORDER ID:</span>
                            <strong><%= order.orderId %></strong>
                        </div>
                        <div class="status-badge status-<%= order.orderStatus.toLowerCase().replace(' ', '-') %>">
                            <%= order.orderStatus %>
                        </div>
                    </div>
                    <div class="order-items-list">
                        <% order.items.forEach(item => { 
                            let imgUrl = '';
                            if (item.productId) {
                                const prod = item.productId;
                                const variant = prod.variants && prod.variants.find(v => v.size === item.size && v.color === item.color);
                                if (variant && variant.images && variant.images.length > 0) {
                                    const primaryImg = variant.images.find(img => img.isPrimary) || variant.images[0];
                                    imgUrl = primaryImg.url;
                                }
                                if (!imgUrl && prod.images && prod.images.length > 0) {
                                    const primaryImg = prod.images.find(img => img.isPrimary) || prod.images[0];
                                    imgUrl = primaryImg.url;
                                }
                            }
                        %>
                            <div class="order-item-row">
                                <div class="item-primary-info">
                                    <% if (imgUrl) { %>
                                        <img src="<%= imgUrl %>" alt="<%= item.productName %>" style="width:64px; height:64px; object-fit:cover; border-radius:8px; flex-shrink:0;">
                                    <% } else { %>
                                        <div class="item-img-placeholder">
                                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                        </div>
                                    <% } %>
                                    <div>
                                        <h6><a href="/product/<%= item.productId ? item.productId._id : '#' %>"><%= item.productName %></a></h6>
                                        <p class="item-meta">Size: <strong><%= item.size %></strong> | Color: <strong><%= item.color %></strong><br>
                                        Qty: <strong><%= item.quantity %></strong> &times; ₹<%= item.price %></p>
                                    </div>
                                </div>
                                
                                <div style="text-align: center;">
                                    <span class="badge-sm badge-<%= item.itemStatus.toLowerCase().replace(' ', '-') %>"><%= item.itemStatus %></span>
                                </div>
                                
                                <div class="item-pricing">
                                    <h6>₹<%= item.totalPrice %></h6>
                                    <% if (item.itemStatus === 'Processing') { %>
                                        <button class="btn-action-sm text-danger cancel-item-btn" data-order-id="<%= order._id %>" data-item-id="<%= item._id %>">Cancel Item</button>
                                    <% } else if (item.itemStatus === 'Delivered') { %>
                                        <button class="btn-action-sm text-warning return-item-btn" data-order-id="<%= order._id %>" data-item-id="<%= item._id %>">Return Item</button>
                                    <% } %>
                                </div>
                                
                                <% if (item.cancellationReason && item.itemStatus === 'Cancelled') { %>
                                    <div class="reason-box reason-danger"><strong>Cancelled:</strong> <%= item.cancellationReason %></div>
                                <% } %>
                                <% if (item.returnReason && item.itemStatus.includes('Return')) { %>
                                    <div class="reason-box reason-warning"><strong>Return:</strong> <%= item.returnReason %></div>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- ── Order Status Timeline ──────────────────────────── -->
                <div class="order-details-card order-status-section">
                    <h6>ORDER STATUS</h6>
                    <div class="timeline-track">
                        <%
                            let tlSteps = [];
                            const cs = order.orderStatus;
                            const hasReturn = order.items.some(i => ['Return Requested', 'Return Approved', 'Returned', 'Return Rejected'].includes(i.itemStatus)) || ['Return Requested', 'Returned'].includes(cs);

                            if (cs === 'Cancelled') {
                                tlSteps = [
                                    { label: 'Order Placed',  cls: 'tl-done',      desc: 'Your order was placed successfully.' },
                                    { label: 'Cancelled',     cls: 'tl-cancelled', desc: order.cancellationReason || 'Order was cancelled.' }
                                ];
                            } else if (hasReturn) {
                                const anyRequested = order.items.some(i => i.itemStatus === 'Return Requested') || cs === 'Return Requested';
                                const anyApproved = order.items.some(i => i.itemStatus === 'Return Approved');
                                const anyReturned = order.items.some(i => i.itemStatus === 'Returned') || cs === 'Returned';
                                const anyRejected = order.items.some(i => i.itemStatus === 'Return Rejected');

                                tlSteps = [
                                    { 
                                        label: 'Order Placed', 
                                        cls: 'tl-done', 
                                        desc: 'Your order was placed successfully.' 
                                    },
                                    { 
                                        label: 'Shipped', 
                                        cls: 'tl-done', 
                                        desc: 'Items shipped to your address.' 
                                    },
                                    { 
                                        label: 'Delivered', 
                                        cls: 'tl-done', 
                                        desc: 'Items delivered successfully.' 
                                    },
                                    { 
                                        label: 'Return Requested', 
                                        cls: (anyApproved || anyReturned || anyRejected) ? 'tl-done' : (anyRequested ? 'tl-return-req' : 'tl-done'),
                                        desc: (anyApproved || anyReturned || anyRejected) ? 'Return request submitted and processed.' : 'Return request submitted, awaiting approval.'
                                    }
                                ];

                                if (anyRejected) {
                                    tlSteps.push({
                                        label: 'Return Rejected',
                                        cls: 'tl-cancelled',
                                        desc: 'Your return request was rejected by the administrator.'
                                    });
                                } else {
                                    tlSteps.push(
                                        { 
                                            label: 'Return Approved', 
                                            cls: anyReturned ? 'tl-done' : (anyApproved ? 'tl-return-approved' : ''),
                                            desc: anyReturned ? 'Return approved.' : (anyApproved ? 'Return approved! Processing pickup/refund.' : 'Awaiting return approval.')
                                        },
                                        { 
                                            label: 'Returned', 
                                            cls: anyReturned ? 'tl-returned' : '',
                                            desc: anyReturned ? 'Return process complete. Refund completed.' : 'Refund completed upon receiving items.'
                                        }
                                    );
                                }
                            } else {
                                tlSteps = [
                                    {
                                        label: 'Order Placed',
                                        cls:   'tl-done',
                                        desc:  'Your order was placed successfully.'
                                    },
                                    {
                                        label: cs === 'Partially Shipped' ? 'Partially Shipped' : 'Shipped',
                                        cls:   ['Shipped','Partially Delivered','Delivered'].includes(cs) ? 'tl-done'
                                             : cs === 'Partially Shipped' ? 'tl-partial' : '',
                                        desc:  cs === 'Partially Shipped'                              ? 'Some of your items have been shipped.'
                                             : ['Shipped','Partially Delivered','Delivered'].includes(cs) ? 'All items have been shipped.'
                                             : 'Awaiting dispatch.'
                                    },
                                    {
                                        label: cs === 'Partially Delivered' ? 'Partially Delivered' : 'Delivered',
                                        cls:   cs === 'Delivered'           ? 'tl-done'
                                             : cs === 'Partially Delivered' ? 'tl-partial' : '',
                                        desc:  cs === 'Partially Delivered' ? 'Some items have been delivered.'
                                             : cs === 'Delivered'           ? 'Your order has been delivered. Enjoy!'
                                             : 'Awaiting delivery.'
                                    }
                                ];
                            }
                        %>
                        <% tlSteps.forEach((step, i) => { %>
                            <div class="tl-step <%= step.cls %>">
                                <div class="tl-gutter">
                                    <div class="tl-dot"></div>
                                    <% if (i < tlSteps.length - 1) { %>
                                        <div class="tl-connector"></div>
                                    <% } %>
                                </div>
                                <div class="tl-body">
                                    <div class="tl-label"><%= step.label %></div>
                                    <% if (step.desc) { %>
                                        <div class="tl-desc"><%= step.desc %></div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="actions-container">
                    <% if (order.orderStatus === 'Processing') { %>
                        <button class="btn-outline-danger" id="cancelOrderBtn" data-order-id="<%= order._id %>">CANCEL ENTIRE ORDER</button>
                    <% } else if (order.orderStatus === 'Delivered') { %>
                        <button class="btn-outline-warning" id="returnOrderBtn" data-order-id="<%= order._id %>">RETURN ENTIRE ORDER</button>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Summary, Address, Payment -->
            <div class="order-summary-panel">
                <div class="summary-card">
                    <h6>ORDER SUMMARY</h6>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>₹<%= order.pricing.subtotal %></span>
                    </div>
                    <div class="summary-row">
                        <span>Discount</span>
                        <span class="text-success">- ₹<%= order.pricing.discount %></span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span><%= order.pricing.shipping === 0 ? 'FREE' : `₹${order.pricing.shipping}` %></span>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <span class="text-primary">₹<%= order.pricing.total %></span>
                    </div>
                    <% if (order.walletAmountUsed > 0) { %>
                        <div class="summary-row" style="margin-top: 10px; border-top: 1px dashed #eee; padding-top: 10px;">
                            <span>Wallet Amount Used</span>
                            <span class="text-success">- ₹<%= order.walletAmountUsed %></span>
                        </div>
                        <div class="summary-row">
                            <span>Remaining Amount</span>
                            <span class="text-primary" style="font-weight: 600;">₹<%= order.remainingAmountPaid %></span>
                        </div>
                    <% } %>
                    <% if (order.refundAmount > 0) { %>
                        <div class="summary-row" style="margin-top: 10px; border-top: 1px dashed #eee; padding-top: 10px;">
                            <span>Refunded to Wallet</span>
                            <span class="text-success" style="font-weight: 600;">₹<%= order.refundAmount %></span>
                        </div>
                        <div class="summary-row">
                            <span>Refund Status</span>
                            <span class="badge" style="background-color: #d1fae5; color: #065f46; font-size: 0.85em; padding: 2px 8px; border-radius: 4px;"><%= order.refundStatus %></span>
                        </div>
                    <% } %>
                </div>

                <div class="summary-card">
                    <h6>SHIPPING ADDRESS</h6>
                    <div class="address-text">
                        <strong><%= order.shippingAddress.firstName %> <%= order.shippingAddress.lastName %></strong>
                        <%= order.shippingAddress.street %><br>
                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.pincode %><br>
                        Phone: <%= order.shippingAddress.mobile %>
                    </div>
                </div>

                <div class="summary-card">
                    <h6>PAYMENT DETAILS</h6>
                    <div class="payment-info">
                        <span class="payment-label">Method</span>
                        <span class="payment-value">
                            <% if (order.walletAmountUsed > 0 && order.remainingAmountPaid > 0) { %>
                                WALLET + <%= order.paymentMethod %> (Partial)
                            <% } else { %>
                                <%= order.paymentMethod %>
                            <% } %>
                        </span>
                    </div>
                    <div class="payment-info" style="<%= order.paymentMethod !== 'RAZORPAY' ? 'margin-bottom:0;' : '' %>">
                        <span class="payment-label">Status</span>
                        <span class="payment-value" style="color: <%= order.paymentStatus === 'Completed' ? '#22c55e' : (order.paymentStatus === 'Failed' ? '#ef4444' : '#f57c00') %>"><%= order.paymentStatus %></span>
                    </div>
                    <% if (order.paymentMethod === 'RAZORPAY') { %>
                        <div class="payment-info">
                            <span class="payment-label">Payment ID</span>
                            <span class="payment-value" style="font-family: monospace; font-size: 0.85em;"><%= order.razorpayPaymentId || 'N/A' %></span>
                        </div>
                        <div class="payment-info" style="margin-bottom:0;">
                            <span class="payment-label">Date</span>
                            <span class="payment-value"><%= order.transactionDate ? new Date(order.transactionDate).toLocaleString('en-IN') : 'N/A' %></span>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/user-footer') %>
    <script src="/js/orders.js"></script>
</body>
</html>
