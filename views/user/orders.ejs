<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/shimmer.js"></script>
    <link rel="stylesheet" href="/css/orders.css">
</head>
<body class="user-layout">
    <%- include('../partials/user-header') %>

    <main class="orders-container">
        <div class="orders-header">
            <h1>YOUR ORDERS</h1>
        </div>

        <div class="orders-controls">
            <div class="status-filters" id="statusFilters">
                <button class="filter-btn active" data-status="All">All</button>
                <button class="filter-btn" data-status="Processing">Processing</button>
                <button class="filter-btn" data-status="Partially Shipped">Partially Shipped</button>
                <button class="filter-btn" data-status="Shipped">Shipped</button>
                <button class="filter-btn" data-status="Partially Delivered">Partially Delivered</button>
                <button class="filter-btn" data-status="Delivered">Delivered</button>
                <button class="filter-btn" data-status="Cancelled">Cancelled</button>
                <button class="filter-btn" data-status="Returned">Returned</button>
            </div>
            <div class="orders-search-box">
                <input type="text" id="orderSearchInput" class="search-input" placeholder="Search by Order ID or Product...">
                <button class="search-btn" id="orderSearchBtn">Search</button>
            </div>
        </div>

        <!-- Orders List -->
        <div class="orders-grid" id="ordersGrid">
            <!-- Filled by AJAX -->
        </div>

        <!-- Pagination -->
        <div id="ordersPagination" style="margin-top: 40px; display: flex; justify-content: center; gap: 10px;"></div>
    </main>

    <%- include('../partials/user-footer') %>
    <script src="/js/orders.js"></script>
    <script>
    (function () {
        let currentStatus = 'All';
        let currentSearch = '';
        let currentPage   = 1;

        // ── Shimmer skeleton ────────────────────────────────────────
        function shimmerHTML() {
            return Array.from({ length: 3 }).map(() => `
                <div class="order-item-card shimmer-card">
                    <div class="order-card-header">
                        <div>
                            <div class="shimmer shimmer-line" style="width:160px; height:16px; margin-bottom:8px;"></div>
                            <div class="shimmer shimmer-line" style="width:100px; height:12px;"></div>
                        </div>
                        <div class="shimmer shimmer-line" style="width:80px; height:24px; border-radius:20px;"></div>
                    </div>
                    <div class="order-card-body">
                        <div class="order-items-preview" style="flex:1; display:flex; flex-direction:column; gap:12px;">
                            <div style="display:flex; gap:12px; align-items:center;">
                                <div class="shimmer" style="width:50px;height:50px;border-radius:6px;flex-shrink:0;"></div>
                                <div style="flex:1;">
                                    <div class="shimmer shimmer-line" style="width:70%; height:13px; margin-bottom:8px;"></div>
                                    <div class="shimmer shimmer-line" style="width:50%; height:11px;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="order-card-totals" style="min-width:150px; text-align:right;">
                            <div class="shimmer shimmer-line" style="width:80px; height:28px; margin:0 0 8px auto;"></div>
                            <div class="shimmer shimmer-line" style="width:60px; height:12px; margin:0 0 12px auto;"></div>
                            <div class="shimmer shimmer-line" style="width:100px; height:36px; border-radius:6px; margin-left:auto;"></div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // ── Status badge colour map ──────────────────────────────────
        const statusClass = {
            'Processing':       'status-processing',
            'Partially Shipped': 'status-partially-shipped',
            'Shipped':          'status-shipped',
            'Partially Delivered': 'status-partially-delivered',
            'Delivered':        'status-delivered',
            'Cancelled':        'status-cancelled',
            'Return Requested': 'status-return-requested',
            'Returned':         'status-returned',
        };

        // ── Render one order card ────────────────────────────────────
        function renderCard(order) {
            const date     = new Date(order.createdAt).toLocaleDateString();
            const badgeCls = statusClass[order.orderStatus] || 'status-processing';
            const preview  = order.items.slice(0, 2).map(item => {
                let imgUrl = '';
                if (item.productId) {
                    const prod = item.productId;
                    const variant = prod.variants && prod.variants.find(v => v.size === item.size && v.color === item.color);
                    if (variant && variant.images && variant.images.length > 0) {
                        const primaryImg = variant.images.find(img => img.isPrimary) || variant.images[0];
                        imgUrl = primaryImg.url;
                    }
                    if (!imgUrl && prod.images && prod.images.length > 0) {
                        const primaryImg = prod.images.find(img => img.isPrimary) || prod.images[0];
                        imgUrl = primaryImg.url;
                    }
                }
                const imgHTML = imgUrl 
                    ? `<img src="${imgUrl}" alt="${item.productName}" style="width:50px; height:50px; object-fit:cover; border-radius:6px; flex-shrink:0;">`
                    : `<div class="item-img-placeholder" style="width:50px;height:50px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#f9f9f9;border-radius:6px;color:#ccc;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                    </div>`;
                return `
                <div class="preview-item">
                    ${imgHTML}
                    <div class="preview-item-info">
                        <h6>${item.productName}</h6>
                        <p>Size: ${item.size} | Color: ${item.color} | Qty: ${item.quantity}</p>
                    </div>
                </div>`;
            }).join('');
            const more = order.items.length > 2
                ? `<div class="preview-more">+ ${order.items.length - 2} more item(s)</div>` : '';

            return `
                <div class="order-item-card">
                    <div class="order-card-header">
                        <div>
                            <h5>ORDER #${order.orderId}</h5>
                            <span class="order-date">Placed on ${date}</span>
                        </div>
                        <div class="status-badge ${badgeCls}">${order.orderStatus}</div>
                    </div>
                    <div class="order-card-body">
                        <div class="order-items-preview">${preview}${more}</div>
                        <div class="order-card-totals">
                            <span class="total-label">Total Amount</span>
                            <div class="total-amount">₹${order.pricing.total}</div>
                            <div class="payment-method">
                                Payment: <strong>${order.paymentMethod}</strong> 
                                <span style="color: ${order.paymentStatus === 'Completed' ? '#22c55e' : (order.paymentStatus === 'Failed' ? '#ef4444' : '#f57c00')}; font-weight: 700;">
                                    (${order.paymentStatus})
                                </span>
                            </div>
                            <a href="/order/${order._id}" class="btn-outline-primary">VIEW DETAILS</a>
                        </div>
                    </div>
                </div>`;
        }

        // ── Render pagination ────────────────────────────────────────
        function renderPagination(currentPage, totalPages) {
            const el = document.getElementById('ordersPagination');
            if (totalPages <= 1) { el.innerHTML = ''; return; }

            const btnStyle = (active) =>
                `style="padding:8px 16px; border:1px solid ${active ? '#111' : '#ddd'}; font-weight:700; border-radius:4px; cursor:pointer; background:${active ? '#111' : '#fff'}; color:${active ? '#fff' : '#111'};"`;

            let html = '';
            if (currentPage > 1)
                html += `<button ${btnStyle(false)} data-page="${currentPage - 1}">&laquo;</button>`;

            for (let i = 1; i <= totalPages; i++)
                html += `<button ${btnStyle(i === currentPage)} data-page="${i}">${i}</button>`;

            if (currentPage < totalPages)
                html += `<button ${btnStyle(false)} data-page="${currentPage + 1}">&raquo;</button>`;

            el.innerHTML = html;
            el.querySelectorAll('button').forEach(btn =>
                btn.addEventListener('click', () => fetchOrders(parseInt(btn.dataset.page)))
            );
        }

        // ── Fetch + render ───────────────────────────────────────────
        async function fetchOrders(page = 1) {
            currentPage = page;
            const grid = document.getElementById('ordersGrid');
            grid.innerHTML = shimmerHTML();

            try {
                const params = new URLSearchParams({
                    status: currentStatus,
                    search: currentSearch,
                    page: currentPage
                });
                const res  = await fetch(`/orders?${params}`, { headers: { 'Accept': 'application/json' } });
                const data = await res.json();

                if (!data.success) throw new Error(data.message);

                if (data.orders.length === 0) {
                    grid.innerHTML = `
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24" width="80" height="80" stroke="currentColor" stroke-width="1.5" fill="none">
                                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                <line x1="8" y1="21" x2="16" y2="21"></line>
                                <line x1="12" y1="17" x2="12" y2="21"></line>
                            </svg>
                            <h4>NO ORDERS FOUND</h4>
                            <p>You don't have any orders matching the selected filters.</p>
                            <a href="/shop" class="btn-primary">START SHOPPING</a>
                        </div>`;
                    document.getElementById('ordersPagination').innerHTML = '';
                } else {
                    grid.innerHTML = data.orders.map(renderCard).join('');
                    renderPagination(data.currentPage, data.totalPages);
                }
            } catch (err) {
                grid.innerHTML = `<div class="empty-state"><h4>Failed to load orders.</h4><p>${err.message}</p></div>`;
            }
        }

        // ── Filter buttons ───────────────────────────────────────────
        document.getElementById('statusFilters').querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentStatus = btn.dataset.status;
                currentSearch = '';
                document.getElementById('orderSearchInput').value = '';
                fetchOrders(1);
            });
        });

        // ── Search ───────────────────────────────────────────────────
        let searchTimer;
        document.getElementById('orderSearchInput').addEventListener('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                currentSearch = this.value.trim();
                fetchOrders(1);
            }, 400);
        });

        document.getElementById('orderSearchBtn').addEventListener('click', () => {
            currentSearch = document.getElementById('orderSearchInput').value.trim();
            fetchOrders(1);
        });

        // ── Initial load ─────────────────────────────────────────────
        fetchOrders(1);
    })();
    </script>
</body>
</html>
