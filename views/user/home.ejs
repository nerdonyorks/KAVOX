<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KAVOX - Home</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <script src="/js/shimmer.js"></script>
</head>

<body class="user-layout">
  <%- include('../partials/user-header') %>


    <!-- Hero Banner -->
    <% if (typeof banners !== 'undefined' && banners.length > 0) { %>
      <style>
        .hero-slider-track {
          display: flex;
          height: 100%;
          width: 100%;
          transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
        }
        .hero-slide {
          position: relative;
          width: 100%;
          height: 100%;
          flex-shrink: 0;
          display: flex;
          align-items: center;
          justify-content: flex-start;
          box-sizing: border-box;
        }
        .hero-slide::before {
          content: "";
          position: absolute;
          inset: 0;
          background: linear-gradient(90deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0) 100%);
          z-index: 2;
          pointer-events: none;
        }
        .hero::before {
          display: none !important;
        }
        @media (max-width: 768px) {
          .hero-slide::before {
            background: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 100%);
          }
        }
        .slide-dot {
          width: 10px;
          height: 10px;
          border-radius: 50%;
          background: rgba(255, 255, 255, 0.4);
          cursor: pointer;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .slide-dot.active {
          background: #ffffff;
          width: 24px;
          border-radius: 5px;
        }
      </style>

      <!-- Slideshow Hero Slider -->
      <section class="hero" style="position: relative; overflow: hidden; background: #000; display: block; padding: 0;">
        <div class="hero-slider-track">
          <% banners.forEach((banner, index) => { %>
            <div class="hero-slide" id="slide-<%= index %>">
              <div class="hero-content" style="z-index: 3; position: relative;">
                <h1><%= banner.title %></h1>
                <% if (banner.subtitle) { %>
                  <p><%= banner.subtitle %></p>
                <% } %>
                <a href="<%= banner.link %>" class="shop-now-btn">EXPLORE COLLECTION</a>
              </div>
              <img src="<%= banner.image %>" alt="<%= banner.title %>" class="hero-image" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; opacity: 0.65;">
            </div>
          <% }) %>
        </div>
        
        <% if (banners.length > 1) { %>
          <!-- Slider Navigation Dots -->
          <div style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 3;">
            <% banners.forEach((_, idx) => { %>
              <span class="slide-dot <%= idx === 0 ? 'active' : '' %>" onclick="handleDotClick(<%= idx %>)"></span>
            <% }) %>
          </div>
        <% } %>
      </section>

      <% if (banners.length > 1) { %>
        <script>
          let currentSlideIndex = 0;
          const slidesCount = <%= banners.length %>;
          const sliderTrack = document.querySelector('.hero-slider-track');
          let autoSlideInterval = null;

          function showSlide(index) {
            if (index < 0) {
              index = slidesCount - 1;
            } else if (index >= slidesCount) {
              index = 0;
            }

            sliderTrack.style.transform = `translateX(-${index * 100}%)`;

            const dots = document.querySelectorAll('.slide-dot');
            dots.forEach((dot, idx) => {
              if (idx === index) {
                dot.classList.add('active');
              } else {
                dot.classList.remove('active');
              }
            });

            currentSlideIndex = index;
          }

          function nextSlide() {
            showSlide(currentSlideIndex + 1);
          }

          function resetInterval() {
            clearInterval(autoSlideInterval);
            autoSlideInterval = setInterval(nextSlide, 5000);
          }

          // Initialize autoplay interval
          autoSlideInterval = setInterval(nextSlide, 5000);

          function handleDotClick(index) {
            showSlide(index);
            resetInterval();
          }
        </script>
      <% } %>
    <% } else { %>
      <!-- Fallback Static Hero Banner -->
      <section class="hero">
        <div class="hero-content">
          <h1>ELEVATE YOUR<br>FOOTWEAR GAME</h1>
          <p>EXPERIENCE PREMIUM COMFORT & STYLE</p>
          <a href="/shop" class="shop-now-btn">EXPLORE COLLECTION</a>
        </div>
        <img src="/images/banner.jpg" alt="Kavox" class="hero-image">
      </section>
    <% } %>

    <!-- New Arrivals -->
    <section class="section">
      <h2 class="section-title" id="resultsTitle">NEW ARRIVALS</h2>
      <div class="products-grid" id="productGrid">
        <% if (typeof products !=='undefined' && products.length> 0) { %>
          <% products.forEach(function(product) { %>
            <%- include('partials/product-card', { product: product }) %>
              <% }); %>
                <% } else { %>
                  <div style="grid-column: 1/-1; text-align: center; padding: 50px; color: #888;">
                    <p>No products available right now. Check back later!</p>
                  </div>
                  <% } %>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
      <p class="services-title">OUR SERVICES</p>
      <div class="services-grid">
        <div class="service-item">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
          </div>
          <h4>5% OFF</h4>
          <p>5% OFF on Pre-paid orders</p>
        </div>
        <div class="service-item">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
              <text x="7" y="20" font-size="5" fill="currentColor">48h</text>
            </svg>
          </div>
          <h4>SHIPPING WITHIN 48 HOURS</h4>
          <p>Your order will be shipped within 48 hours from the time since order is placed</p>
        </div>
        <div class="service-item">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <h4>QUALITY CRAFTED</h4>
          <p>Crafted with quality and care in India, from raw materials to the final product.</p>
        </div>
        <div class="service-item">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
              </path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h4>DURABLE FOOTWEAR</h4>
          <p>Durable, stylish footwear built for everyday comfort.</p>
        </div>
      </div>
    </section>

    <%- include('../partials/user-footer') %>

      <script>
        function toggleMobileNav() {
          document.getElementById('mobileNav').classList.toggle('active');
        }

        function buyNow(productId) {
          // Buy now logic
          window.location.href = '/product/' + productId;
        }

        // Modern Search Implementation
        const searchInput = document.getElementById('globalSearchInput');
        const productGrid = document.getElementById('productGrid');
        const resultsTitle = document.getElementById('resultsTitle');

        let searchTimeout = null;

        if (searchInput) {
          searchInput.addEventListener('input', function (e) {
            const searchTerm = e.target.value.trim();

            clearTimeout(searchTimeout);

            // Apply shimmer overlay instead of skeletons
            productGrid.classList.add('is-loading-container');

            searchTimeout = setTimeout(() => {
              performSearch(searchTerm);
            }, 500); // 500ms debounce
          });
        }

        function showSkeletons() {
          // Removed in favor of global shimmer overlay
        }

        async function performSearch(query) {
          try {
            // Guarantee a minimum shimmer duration of 600ms for a premium feel
            const [response] = await Promise.all([
              fetch(`/?search=${encodeURIComponent(query)}`, {
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
              }),
              new Promise(resolve => setTimeout(resolve, 600))
            ]);

            const data = await response.json();

            productGrid.classList.remove('is-loading-container');

            if (data.success) {
              renderProducts(data.products, query);
            }
          } catch (err) {
            console.error('Search error:', err);
          }
        }

        function renderProducts(products, query) {
          resultsTitle.textContent = query ? `SEARCH RESULTS FOR "${query.toUpperCase()}"` : 'NEW ARRIVALS';

          if (products.length === 0) {
            productGrid.innerHTML = `
                <div style="grid-column: 1/-1; text-align: center; padding: 50px; color: #666;">
                    <h3>No products found for "${query}"</h3>
                    <p>Try checking your spelling or use more general terms</p>
                </div>
            `;
            return;
          }

          productGrid.innerHTML = products.map(product => {
            const pOffer = product.productOffer || 0;
            const cOffer = (product.category && typeof product.category === 'object' && product.category.offer) ? product.category.offer : (product.categoryOffer || 0);
            const discount = Math.max(pOffer, cOffer);
            const finalPrice = Math.round(product.price * (1 - discount / 100));
            const imgSrc = product.images && product.images.length > 0
              ? (product.images.find(img => img.isPrimary)?.url || product.images[0].url)
              : product.image;

            return `
            <div class="product-card">
                <div class="product-image-wrapper">
                    ${discount > 0 ? `<div class="badge-offer">-${discount}% OFF</div>` : ''}
                    <a href="/product/${product._id}">
                        <img src="${imgSrc}" alt="${product.name}" loading="lazy">
                    </a>
                    
                    <div class="product-quick-actions">
                        <button class="wishlist-btn ${product.isInWishlist ? 'active' : ''}" 
                                title="Add to Wishlist" 
                                onclick="toggleWishlist('${product._id}', this)">
                            <svg viewBox="0 0 24 24" ${product.isInWishlist ? 'fill="#e91e63"' : 'fill="none"'} stroke="currentColor" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="product-card-info">
                    <span class="product-brand">${product.brand || 'KAVOX'}</span>
                    <a href="/product/${product._id}" class="product-name" title="${product.name}">${product.name}</a>
                    <div class="product-pricing">
                        <span class="final-price">₹${finalPrice}</span>
                        ${discount > 0 ? `<span class="base-price">₹${product.price}</span>` : ''}
                    </div>
                    <div class="product-card-actions">
                        <button class="btn-action" onclick="openAddToCartModal('${product._id}')">Add to Cart</button>
                        <button class="btn-action" onclick="window.location.href='/product/${product._id}'">View Details</button>
                    </div>
                </div>
            </div>
            `;
          }).join('');
        }
      </script>
</body>

</html>