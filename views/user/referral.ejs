<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Premium aesthetics for Referral System */
    .referral-hero-card {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      color: #fff;
      border-radius: 16px;
      padding: 40px;
      margin-bottom: 30px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .referral-hero-card::after {
      content: "";
      position: absolute;
      top: -50%;
      left: -20%;
      width: 350px;
      height: 350px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(233, 30, 99, 0.12) 0%, rgba(233, 30, 99, 0) 70%);
      pointer-events: none;
    }

    .referral-title {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 10px;
    }

    .referral-subtitle {
      font-size: 14px;
      color: #94a3b8;
      margin-bottom: 30px;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .referral-code-wrapper {
      background: rgba(255, 255, 255, 0.05);
      border: 1px dashed rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      padding: 15px 25px;
      display: inline-flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 10px;
    }

    .referral-code-text {
      font-family: monospace;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 2.5px;
      color: #38bdf8;
    }

    .btn-copy-code {
      background: #38bdf8;
      color: #0f172a;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: all 0.2s ease;
    }

    .btn-copy-code:hover {
      background: #0ea5e9;
      transform: scale(1.02);
    }

    .referral-link-sub {
      font-size: 12px;
      color: #64748b;
      margin-top: 5px;
      word-break: break-all;
    }

    .referral-stats-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 30px;
    }

    .referral-stat-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 25px;
      text-align: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .referral-stat-lbl {
      font-size: 11px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .referral-stat-val {
      font-size: 28px;
      font-weight: 800;
      color: #0f172a;
    }

    .referred-list-title {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 15px;
      color: #1e293b;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 8px;
    }

    .referred-table-container {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .referred-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .referred-table th {
      background: #f8fafc;
      padding: 16px 20px;
      font-size: 11px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid #e2e8f0;
    }

    .referred-table td {
      padding: 16px 20px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      color: #334155;
    }

    .referred-table tr:last-child td {
      border-bottom: none;
    }

    .referred-empty-state {
      padding: 40px;
      text-align: center;
      color: #94a3b8;
    }

    .back-btn-profile {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 25px;
      transition: color 0.2s ease;
    }

    .back-btn-profile:hover {
      color: #0f172a;
    }
  </style>
</head>

<body class="user-layout">
  <%- include('../partials/user-header') %>

  <main class="main-content">
    <div class="profile-container">

      <!-- Back Link -->
      <a href="/account" class="back-btn-profile">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Profile
      </a>

      <!-- Hero Card -->
      <div class="referral-hero-card">
        <h2 class="referral-title">Invite Friends, Earn Wallet Cash!</h2>
        <p class="referral-subtitle">
          Share your referral code. When a friend signs up, you get ₹150 and they get ₹50 signup bonus credited directly to their wallet!
        </p>

        <div class="referral-code-wrapper">
          <span class="referral-code-text" id="shareCodeText"><%= referralCode %></span>
          <button class="btn-copy-code" onclick="copyReferralLink()">Copy Link</button>
        </div>
        <div class="referral-link-sub">
          Share Link: <span id="shareLinkSpan" style="font-family: monospace; font-weight: 600; color: #94a3b8;"></span>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="referral-stats-container">
        <div class="referral-stat-card">
          <div class="referral-stat-lbl">Total Referred Friends</div>
          <div class="referral-stat-val"><%= totalReferrals %></div>
        </div>
        <div class="referral-stat-card">
          <div class="referral-stat-lbl">Total Cash Earned</div>
          <div class="referral-stat-val" style="color: #059669;">₹<%= totalEarned.toFixed(2) %></div>
        </div>
      </div>

      <!-- Referred Friends Ledger -->
      <h3 class="referred-list-title">MY REFERRED FRIENDS</h3>
      <div class="referred-table-container">
        <% if (referrals && referrals.length > 0) { %>
          <table class="referred-table">
            <thead>
              <tr>
                <th>Friend's Name</th>
                <th>Registration Date</th>
                <th>Status</th>
                <th style="text-align: right;">Cash Earned</th>
              </tr>
            </thead>
            <tbody>
              <% referrals.forEach(ref => { %>
                <tr>
                  <td style="font-weight: 700; color: #1e293b;">
                    <%= ref.referredId ? ref.referredId.name : 'Unknown User' %>
                  </td>
                  <td>
                    <%= new Date(ref.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </td>
                  <td>
                    <span class="status-badge status-active" style="padding: 3px 8px; font-size: 0.75rem;">
                      <%= ref.status %>
                    </span>
                  </td>
                  <td style="text-align: right; font-weight: 700; color: #059669;">
                    +₹<%= ref.rewardAmount.toFixed(2) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="referred-empty-state">
            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin: 0 auto 15px; display: block; color: #cbd5e1;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
            <p style="font-weight: 600; margin-bottom: 5px;">No referrals yet</p>
            <p style="font-size: 13px; color: #94a3b8;">Copy your link above and invite your friends to start earning wallet cash!</p>
          </div>
        <% } %>
      </div>

    </div>
  </main>

  <%- include('../partials/user-footer') %>

  <script>
    // Construct pre-filled referral URL on load dynamically
    document.addEventListener("DOMContentLoaded", () => {
      const code = document.getElementById("shareCodeText").textContent.trim();
      const origin = window.location.origin;
      const shareUrl = `${origin}/register?ref=${code}`;
      document.getElementById("shareLinkSpan").textContent = shareUrl;
    });

    async function copyReferralLink() {
      const code = document.getElementById("shareCodeText").textContent.trim();
      const origin = window.location.origin;
      const shareUrl = `${origin}/register?ref=${code}`;
      
      try {
        await navigator.clipboard.writeText(shareUrl);
        // We can check if KAVOX has a notify system
        if (typeof KavoxNotify !== "undefined") {
          KavoxNotify.toast("Referral link copied to clipboard!", "success");
        } else {
          alert("Referral link copied!");
        }
      } catch (err) {
        console.error("Failed to copy link:", err);
      }
    }
  </script>
</body>

</html>
