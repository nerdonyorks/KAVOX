<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Address - KAVOX SOLE LAB</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: #333;
        }

        /* Header Styles */
        .header {
            background-color: #1a1a1a;
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-img {
            height: 40px;
            filter: invert(0);
        }

        .logo-sub {
            font-size: 9px;
            color: #fff;
            letter-spacing: 8px;
            margin-top: 2px;
            text-transform: uppercase;
        }

        .search-box {
            flex: 1;
            max-width: 400px;
            display: flex;
            align-items: center;
            background-color: #333;
            border-radius: 4px;
            padding: 8px 12px;
            gap: 10px;
        }

        .search-box input {
            flex: 1;
            background: none;
            border: none;
            outline: none;
            color: #fff;
            font-size: 13px;
        }

        .search-box input::placeholder {
            color: #888;
        }

        .search-box svg {
            color: #888;
            width: 18px;
            height: 18px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .nav-links a:hover {
            color: #4ade80;
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .header-icons a {
            color: #fff;
            display: flex;
            align-items: center;
        }

        .header-icons svg {
            width: 22px;
            height: 22px;
        }

        .sign-in-btn {
            background-color: #e91e63;
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
        }

        .sign-in-btn:hover {
            background-color: #c2185b;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            padding: 40px 60px;
            max-width: 1000px;
            width: 100%;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #000;
            text-decoration: underline;
            text-underline-offset: 6px;
        }

        /* Form Card */
        .form-card {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 40px 50px;
        }

        .form-row {
            display: flex;
            gap: 30px;
            margin-bottom: 25px;
        }

        .form-row.full-width {
            display: block;
        }

        .form-group {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 14px;
            color: #333;
        }

        .form-group label .required {
            color: #e91e63;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
            background-color: #fff;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #333;
        }

        .submit-btn-container {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

        .submit-btn {
            background-color: #e91e63;
            color: #fff;
            border: none;
            padding: 14px 50px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 500;
            letter-spacing: 1px;
            cursor: pointer;
            text-transform: uppercase;
            transition: background-color 0.2s;
        }

        .footer {
            background-color: #1a1a1a;
            padding: 50px 30px 20px;
            color: #fff;
            margin-top: auto;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .form-card { padding: 25px 20px; }
            .form-row { flex-direction: column; gap: 20px; }
            .header { padding: 12px 15px; }
            .search-box { display: none; }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="logo-container">
            <img src="/images/logo.png" alt="KAVOX" class="logo-img">
            <span class="logo-sub">S O L E &nbsp; L A B</span>
        </div>
        <nav class="nav-links">
            <a href="/">HOME</a>
            <a href="/shop">SHOP</a>
            <a href="/orders">ORDERS</a>
        </nav>
        <div class="header-icons">
            <a href="/cart" title="Cart"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line></svg></a>
            <a href="/wishlist" title="Wishlist"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></a>
            <a href="/account" title="Account"><div class="profile-mini"><%= locals.user && user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div></a>
        </div>
    </header>

    <main class="main-content">
        <div class="page-header">
            <h1 class="page-title">EDIT ADDRESS</h1>
        </div>

        <div class="form-card">
            <form action="/address/edit/<%= address._id %>" method="POST" id="editAddressForm" novalidate>
                <div class="form-row">
                    <div class="form-group">
                        <label>First Name <span class="required">*</span></label>
                        <input type="text" name="firstName" id="firstName" value="<%= address.firstName || '' %>">
                        <div class="error-msg" id="firstNameError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                    <div class="form-group">
                        <label>Last Name <span class="required">*</span></label>
                        <input type="text" name="lastName" id="lastName" value="<%= address.lastName || '' %>">
                        <div class="error-msg" id="lastNameError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Mobile Number <span class="required">*</span></label>
                        <input type="tel" name="mobile" id="mobile" value="<%= address.mobile %>" maxlength="10">
                        <div class="error-msg" id="mobileError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                    <div class="form-group">
                        <label>Pincode <span class="required">*</span></label>
                        <input type="text" name="pincode" id="pincode" value="<%= address.pin %>" maxlength="6">
                        <div class="error-msg" id="pincodeError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                </div>

                <div class="form-row full-width">
                    <div class="form-group">
                        <label>House No., Building Name <span class="required">*</span></label>
                        <input type="text" name="street" id="street" value="<%= address.addressLine %>">
                        <div class="error-msg" id="streetError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>State <span class="required">*</span></label>
                        <input type="text" name="state" id="state" value="<%= address.state %>">
                        <div class="error-msg" id="stateError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                    <div class="form-group">
                        <label>City <span class="required">*</span></label>
                        <input type="text" name="city" id="city" value="<%= address.city %>">
                        <div class="error-msg" id="cityError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                </div>

                <div class="form-row full-width">
                    <div class="form-group">
                        <label>Type <span class="required">*</span></label>
                        <select name="type" id="type">
                            <option value="HOME" <%= address.type === 'HOME' ? 'selected' : '' %>>Home</option>
                            <option value="WORK" <%= address.type === 'WORK' ? 'selected' : '' %>>Work</option>
                            <option value="OTHER" <%= address.type === 'OTHER' ? 'selected' : '' %>>Other</option>
                        </select>
                        <div class="error-msg" id="typeError" style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                    </div>
                </div>

                <div class="submit-btn-container">
                    <button type="submit" class="submit-btn">UPDATE ADDRESS</button>
                    <a href="/user/address" style="margin-left: 20px; color: #666; text-decoration: none; font-size: 14px;">Cancel</a>
                </div>
            </form>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const form = document.getElementById('editAddressForm');
                    const pincodeInput = document.getElementById('pincode');
                    const cityInput = document.getElementById('city');
                    const stateInput = document.getElementById('state');
                    const mobileInput = document.getElementById('mobile');

                    const showError = (inputId, message) => {
                        const errorDiv = document.getElementById(inputId + 'Error');
                        if (errorDiv) {
                            errorDiv.textContent = message;
                            errorDiv.style.display = 'block';
                        }
                        document.getElementById(inputId).style.borderColor = '#e91e63';
                    };

                    const hideError = (inputId) => {
                        const errorDiv = document.getElementById(inputId + 'Error');
                        if (errorDiv) {
                            errorDiv.textContent = '';
                            errorDiv.style.display = 'none';
                        }
                        document.getElementById(inputId).style.borderColor = '#ccc';
                    };

                    // Pincode API validation
                    pincodeInput.addEventListener('input', async (e) => {
                        const pincode = e.target.value.trim();
                        if (pincode.length === 6 && /^\d{6}$/.test(pincode)) {
                            hideError('pincode');
                            try {
                                const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                                const data = await response.json();
                                if (data[0].Status === "Success") {
                                    const details = data[0].PostOffice[0];
                                    cityInput.value = details.District;
                                    stateInput.value = details.State;
                                    hideError('city');
                                    hideError('state');
                                } else {
                                    showError('pincode', 'Invalid Indian pincode');
                                }
                            } catch (error) {
                                console.error('Pincode API error:', error);
                            }
                        } else if (pincode.length > 0) {
                            showError('pincode', 'Pincode must be 6 digits');
                        }
                    });

                    form.addEventListener('submit', (e) => {
                        let isValid = true;
                        const fields = ['firstName', 'lastName', 'mobile', 'pincode', 'street', 'state', 'city'];
                        
                        fields.forEach(field => {
                            const input = document.getElementById(field);
                            if (!input.value.trim()) {
                                showError(field, 'This field is required');
                                isValid = false;
                            } else {
                                hideError(field);
                                if (field === 'mobile') {
                                    if (!/^\d{10}$/.test(input.value)) {
                                        showError('mobile', 'Mobile number must be exactly 10 digits');
                                        isValid = false;
                                    } else if (/^(\d)\1{9}$/.test(input.value)) {
                                        showError('mobile', 'Invalid mobile number');
                                        isValid = false;
                                    }
                                }
                                if (field === 'pincode' && !/^\d{6}$/.test(input.value)) {
                                    showError('pincode', 'Pincode must be 6 digits');
                                    isValid = false;
                                }
                            }
                        });

                        if (!isValid) e.preventDefault();
                    });
                });
            </script>
        </div>
    </main>

    <footer class="footer">
        <!-- Simplified footer for consistency -->
        <div style="text-align: center; font-size: 12px; color: #888;">&copy; 2026 KAVOX. All Rights Reserved.</div>
    </footer>
</body>
</html>
