<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Address - KAVOX SOLE LAB</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/shimmer.js"></script>
    <style>
        /* Main Content */
        .main-content {
            flex: 1;
            padding: 40px 20px;
            max-width: 1000px;
            width: 100%;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #000;
            text-decoration: underline;
            text-underline-offset: 6px;
        }

        /* Form Card */
        .form-card {
            border: 1px solid #ccc;
            border-radius: 8px;
            padding: 40px 50px;
            background: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .form-row {
            display: flex;
            gap: 30px;
            margin-bottom: 25px;
        }

        .form-row.full-width {
            display: block;
        }

        .form-group {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 14px;
            color: #333;
            font-weight: 600;
        }

        .form-group label .required {
            color: #e91e63;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
            background-color: #fff;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #e91e63;
        }

        .submit-btn-container {
            display: flex;
            justify-content: center;
            margin-top: 30px;
            align-items: center;
            gap: 20px;
        }

        .submit-btn {
            background-color: #e91e63;
            color: #fff;
            border: none;
            padding: 14px 50px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: pointer;
            text-transform: uppercase;
            transition: opacity 0.2s;
        }

        .submit-btn:hover {
            opacity: 0.9;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .form-card {
                padding: 25px 20px;
            }

            .form-row {
                flex-direction: column;
                gap: 20px;
            }

            .submit-btn-container {
                flex-direction: column;
            }

            .submit-btn {
                width: 100%;
            }
        }
    </style>
</head>

<body class="user-layout">
    <%- include('../partials/user-header') %>


        <main class="main-content">
            <div class="page-header">
                <h1 class="page-title">EDIT ADDRESS</h1>
            </div>

            <div class="form-card">
                <form action="/address/edit/<%= address._id %>" method="POST" id="editAddressForm" novalidate>
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name <span class="required">*</span></label>
                            <input type="text" name="firstName" id="firstName" value="<%= address.firstName || '' %>">
                            <div class="error-msg" id="firstNameError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                        <div class="form-group">
                            <label>Last Name <span class="required">*</span></label>
                            <input type="text" name="lastName" id="lastName" value="<%= address.lastName || '' %>">
                            <div class="error-msg" id="lastNameError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Mobile Number <span class="required">*</span></label>
                            <input type="tel" name="mobile" id="mobile" value="<%= address.mobile %>" maxlength="10">
                            <div class="error-msg" id="mobileError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                        <div class="form-group">
                            <label>Pincode <span class="required">*</span></label>
                            <input type="text" name="pincode" id="pincode" value="<%= address.pincode %>" maxlength="6">
                            <div class="error-msg" id="pincodeError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                    </div>

                    <div class="form-row full-width">
                        <div class="form-group">
                            <label>House No., Building Name <span class="required">*</span></label>
                            <input type="text" name="street" id="street" value="<%= address.street %>">
                            <div class="error-msg" id="streetError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>State <span class="required">*</span></label>
                            <input type="text" name="state" id="state" value="<%= address.state %>">
                            <div class="error-msg" id="stateError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                        <div class="form-group">
                            <label>City <span class="required">*</span></label>
                            <input type="text" name="city" id="city" value="<%= address.city %>">
                            <div class="error-msg" id="cityError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                    </div>

                    <div class="form-row full-width">
                        <div class="form-group">
                            <label>Type <span class="required">*</span></label>
                            <select name="type" id="type">
                                <option value="HOME" <%=address.type==='HOME' ? 'selected' : '' %>>Home</option>
                                <option value="WORK" <%=address.type==='WORK' ? 'selected' : '' %>>Work</option>
                                <option value="OTHER" <%=address.type==='OTHER' ? 'selected' : '' %>>Other</option>
                            </select>
                            <div class="error-msg" id="typeError"
                                style="color: #e91e63; font-size: 12px; margin-top: 5px; display: none;"></div>
                        </div>
                    </div>

                    <div class="submit-btn-container">
                        <button type="submit" class="submit-btn">UPDATE ADDRESS</button>
                        <a href="<%= locals.returnTo ? returnTo : '/user/address' %>"
                            style="margin-left: 20px; color: #666; text-decoration: none; font-size: 14px; font-weight: 600;">Cancel</a>
                    </div>
                </form>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const form = document.getElementById('editAddressForm');
                        const pincodeInput = document.getElementById('pincode');
                        const cityInput = document.getElementById('city');
                        const stateInput = document.getElementById('state');
                        const mobileInput = document.getElementById('mobile');

                        // Attach real-time error clearing
                        ['firstName', 'lastName', 'mobile', 'pincode', 'street', 'state', 'city', 'type'].forEach(id => {
                            const input = document.getElementById(id);
                            if (input) {
                                const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
                                input.addEventListener(eventType, () => hideError(id));
                            }
                        });

                        const showError = (inputId, message) => {
                            const errorDiv = document.getElementById(inputId + 'Error');
                            if (errorDiv) {
                                errorDiv.textContent = message;
                                errorDiv.style.display = 'block';
                            }
                            document.getElementById(inputId).style.borderColor = '#e91e63';
                        };

                        const hideError = (inputId) => {
                            const errorDiv = document.getElementById(inputId + 'Error');
                            if (errorDiv) {
                                errorDiv.textContent = '';
                                errorDiv.style.display = 'none';
                            }
                            document.getElementById(inputId).style.borderColor = '#ccc';
                        };

                        // Pincode API validation
                        pincodeInput.addEventListener('input', async (e) => {
                            const pincode = e.target.value.trim();
                            if (pincode.length === 6 && /^\d{6}$/.test(pincode)) {
                                hideError('pincode');
                                try {
                                    const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                                    const data = await response.json();
                                    if (data[0].Status === "Success") {
                                        const details = data[0].PostOffice[0];
                                        cityInput.value = details.District;
                                        stateInput.value = details.State;
                                        hideError('city');
                                        hideError('state');
                                    } else {
                                        showError('pincode', 'Invalid Indian pincode');
                                    }
                                } catch (error) {
                                    console.error('Pincode API error:', error);
                                }
                            } else if (pincode.length > 0) {
                                showError('pincode', 'Pincode must be 6 digits');
                            }
                        });

                        form.addEventListener('submit', async (e) => {
                            e.preventDefault();

                            let isValid = true;
                            const fields = ['firstName', 'lastName', 'mobile', 'pincode', 'street', 'state', 'city', 'type'];

                            const formData = {};
                            fields.forEach(field => {
                                const input = document.getElementById(field);
                                if (!input.value.trim()) {
                                    showError(field, 'This field is required');
                                    isValid = false;
                                } else {
                                    hideError(field);
                                    formData[field] = input.value.trim();
                                    if (field === 'mobile') {
                                        if (!/^\d{10}$/.test(input.value)) {
                                            showError('mobile', 'Mobile number must be exactly 10 digits');
                                            isValid = false;
                                        } else if (/^(\d)\1{9}$/.test(input.value)) {
                                            showError('mobile', 'Invalid mobile number');
                                            isValid = false;
                                        }
                                    }
                                    if (field === 'pincode' && !/^\d{6}$/.test(input.value)) {
                                        showError('pincode', 'Pincode must be 6 digits');
                                        isValid = false;
                                    }
                                }
                            });

                            if (isValid) {
                                const submitBtn = document.querySelector('.submit-btn');
                                form.classList.add('is-loading', 'loading-overlay');
                                submitBtn.classList.add('skeleton');
                                submitBtn.disabled = true;

                                try {
                                    const addressId = '<%= address._id %>';
                                    const response = await fetch(`/api/users/addresses/${addressId}`, {
                                        method: 'PUT',
                                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        body: JSON.stringify(formData)
                                    });
                                    const data = await response.json();
                                    if (data.success) {
                                        const returnUrl = '<%= locals.returnTo || "/user/address" %>';
                                        window.location.href = returnUrl;
                                    } else {
                                        alert(data.message || 'Failed to update address');
                                    }
                                } catch (error) {
                                    console.error('Update Address Error:', error);
                                    alert('An internal error occurred');
                                } finally {
                                    form.classList.remove('is-loading', 'loading-overlay');
                                    submitBtn.classList.remove('skeleton');
                                    submitBtn.disabled = false;
                                }
                            }
                        });
                    });
                </script>
            </div>
        </main>

        <%- include('../partials/user-footer') %>
</body>

</html>