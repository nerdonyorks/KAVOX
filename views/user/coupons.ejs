<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/notifications.js"></script>
  <script src="/js/shimmer.js"></script>
  <style>
    .user-coupons-container {
      max-width: 980px;
      margin: 40px auto;
      padding: 0 40px;
    }

    .user-coupons-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 24px;
    }

    .user-coupons-header h1 {
      margin: 0 0 8px;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .user-coupons-header p {
      margin: 0;
      color: #64748b;
      font-size: 13px;
    }

    .user-coupons-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .user-coupon-card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 22px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .user-coupon-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: #e91e63;
    }

    .user-coupon-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 16px;
    }

    .user-coupon-code {
      font-family: monospace;
      font-size: 18px;
      font-weight: 800;
      color: #111827;
      letter-spacing: 1.2px;
    }

    .user-coupon-save {
      background: #fff1f2;
      color: #e91e63;
      border-radius: 999px;
      padding: 7px 10px;
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .user-coupon-meta {
      color: #64748b;
      font-size: 13px;
      line-height: 1.7;
      margin-bottom: 18px;
    }

    .user-coupon-actions {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
    }

    .copy-coupon-btn,
    .shop-coupon-btn {
      height: 38px;
      border-radius: 4px;
      border: 0;
      padding: 0 16px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .copy-coupon-btn {
      background: #111827;
      color: #fff;
    }

    .shop-coupon-btn {
      background: #f3f4f6;
      color: #111827;
    }

    .empty-coupons {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 42px;
      text-align: center;
      color: #64748b;
    }

    @media (max-width: 768px) {
      .user-coupons-container {
        padding: 0 20px;
      }

      .user-coupons-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .user-coupons-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body class="user-layout">
  <%- include('../partials/user-header') %>

  <main class="user-coupons-container">
    <div class="user-coupons-header">
      <div>
        <h1>COUPONS</h1>
        <p>Currently available offers for your next order.</p>
      </div>
      <a href="/shop" class="shop-coupon-btn">SHOP NOW</a>
    </div>

    <% if (typeof coupons !== 'undefined' && coupons.length > 0) { %>
      <div class="user-coupons-grid">
        <% coupons.forEach(coupon => {
          const expiryLabel = formatDateOnly(coupon.expiryDate);
        %>
          <article class="user-coupon-card">
            <div class="user-coupon-top">
              <div class="user-coupon-code"><%= coupon.code %></div>
              <div class="user-coupon-save">SAVE <%= coupon.discountType === 'fixed' ? '₹' + coupon.discountValue : coupon.discountValue + '%' %></div>
            </div>
            <div class="user-coupon-meta">
              Minimum order ₹<%= coupon.minPurchaseAmount %><br>
              <% if (coupon.discountType === 'percentage' && coupon.maxDiscount) { %>Maximum discount ₹<%= coupon.maxDiscount %><br><% } %>
              Valid till <%= expiryLabel %>
            </div>
            <div class="user-coupon-actions">
              <button type="button" class="copy-coupon-btn" data-code="<%= coupon.code %>">COPY CODE</button>
              <a href="/checkout" class="shop-coupon-btn">USE COUPON</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-coupons">
        No coupons are available right now.
      </div>
    <% } %>
  </main>

  <%- include('../partials/user-footer') %>

  <script>
    document.querySelectorAll('.copy-coupon-btn').forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.dataset.code;
        try {
          await navigator.clipboard.writeText(code);
          KavoxNotify.toast('Coupon code copied.', 'success');
        } catch (error) {
          KavoxNotify.toast(code, 'success');
        }
      });
    });
  </script>
</body>

</html>
