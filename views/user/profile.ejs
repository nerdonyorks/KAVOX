<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile - KAVOX SOLE LAB</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/notifications.js"></script>
  <script src="/js/shimmer.js"></script>
  <!-- Cropper.js -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script src="/js/cropperManager.js"></script>
</head>

<body class="user-layout">
  <%- include('../partials/user-header') %>

    <!-- Main Content -->
    <main class="main-content">
      <div class="profile-container">
        <div class="profile-card">
          <div class="profile-card-header">
            <h1>USER PROFILE</h1>
            <a href="/profile/edit" class="edit-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </a>
          </div>

          <div class="profile-main-section">
            <div class="profile-avatar" onclick="document.getElementById('profileImageInput').click()">
              <% if (user.profileImage && user.profileImage !=="/images/default-user.png" ) { %>
                <img src="<%= user.profileImage %>" alt="Profile Image">
                <% } else { %>
                  <div class="profile-initials">
                    <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                  </div>
                  <% } %>
            </div>

            <div class="profile-info-grid">
              <div class="info-row">
                <span class="info-label">Full Name</span>
                <span class="info-value">
                  <%= user.name || 'N/A' %>
                </span>
              </div>
              <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value">
                  <%= user.email || 'N/A' %>
                </span>
              </div>
              <div class="info-row">
                <span class="info-label">Address</span>
                <span class="info-value">
                  <% let defaultAddr=user.addresses ? user.addresses.find(a=> a.isDefault) : null;
                    if (!defaultAddr && user.addresses && user.addresses.length > 0) defaultAddr = user.addresses[0];
                    %>
                    <%= defaultAddr ? `${defaultAddr.street}, ${defaultAddr.city}` : 'N/A' %>
                </span>
              </div>
              <div class="info-row no-border">
                <span class="info-label">Mobile No.</span>
                <span class="info-value">
                  <%= user.phone || 'N/A' %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="profile-actions-grid">
          <a href="/cart" class="profile-action-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e91e63" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
            </svg>
            <span>MY CART</span>
          </a>
          <a href="/wishlist" class="profile-action-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e91e63" stroke-width="2">
              <path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
              </path>
            </svg>
            <span>MY WISHLIST</span>
          </a>
          <a href="/user/address" class="profile-action-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e91e63" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>ADDRESSES</span>
          </a>
          <a href="/wallet" class="profile-action-btn">
            <span>WALLET</span>
          </a>
          <a href="/coupons" class="profile-action-btn">
            <span>COUPONS</span>
          </a>
          <a href="/referral" class="profile-action-btn">
            <span>REFERRAL</span>
          </a>
        </div>
      </div>
    </main>

    <%- include('../partials/user-footer') %>


      <%- include('../partials/cropperModal') %>

</body>

</html>