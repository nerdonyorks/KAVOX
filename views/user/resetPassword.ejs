<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - KAVOX SOLE LAB...!!!!!!!!!!</title>
    <script src="/js/notifications.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/shimmer.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }


        /* Main Content */
        .main-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .card {
            border: 2px solid #000000;
            border-radius: 4px;
            padding: 40px 60px;
            width: 100%;
            max-width: 550px;
            text-align: center;
        }

        .card-logo {
            margin-bottom: 25px;
        }

        .card-logo img {
            height: 40px;
        }

        .card-logo .subtitle {
            font-size: 10px;
            letter-spacing: 8px;
            color: #000;
            font-weight: 600;
            margin-top: 5px;
            text-indent: 8px;
        }

        .title {
            font-size: 28px;
            font-weight: 700;
            color: #000000;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1.5px solid #000000;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            border-color: #e91e63;
            box-shadow: 0 0 5px rgba(233, 30, 99, 0.2);
        }

        .password-toggle-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            cursor: pointer;
            color: #666;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            padding: 0;
            outline: none;
            transition: color 0.2s;
        }

        .toggle-password:hover {
            color: #333;
        }

        .toggle-password svg {
            width: 18px;
            height: 18px;
        }

        .error-text {
            color: #e91e63;
            font-size: 11px;
            margin-top: 5px;
            font-weight: 500;
            display: block;
        }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background-color: #000000;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .submit-btn:hover {
            background-color: #333;
            transform: translateY(-1px);
        }

        .back-btn {
            display: block;
            width: 100%;
            padding: 14px;
            background-color: #ffffff;
            color: #000000;
            border: 1.5px solid #000000;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
        }

        .back-btn:hover {
            background-color: #f5f5f5;
        }

        @media (max-width: 480px) {
            .card {
                padding: 30px 20px;
                border: 1px solid #000;
            }

            .header {
                padding: 10px 15px;
            }
        }
    </style>
</head>

<body class="user-layout">
    <%- include('../partials/user-header') %>

    <div class="main-container">
        <div class="card">
            <div class="card-logo">
                <img src="/images/logo.png" alt="KAVOX">
                <div class="subtitle">S O L E &nbsp;&nbsp; L A B</div>
            </div>

            <h1 class="title"><%= user.password ? 'Reset Password' : 'Set Password' %></h1>

            <form id="resetPasswordForm" action="/profile/reset-password" method="POST">
                <div id="generalError" class="error-text" style="display: none; text-align: center; margin-bottom: 15px; padding: 10px; background: #fff5f5; border: 1px solid #e91e63; border-radius: 4px;"></div>
                <% if (user.password) { %>
                <div class="form-group">
                    <label for="oldPassword">Old Password</label>
                    <div class="password-toggle-group">
                        <input type="password" name="oldPassword" id="oldPassword"
                            value="<%= typeof oldPassword !== 'undefined' ? oldPassword : '' %>">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('oldPassword', this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div id="oldPasswordError" class="error-text" style="display: none;"></div>
                    <% if (typeof errors !=='undefined' && errors.oldPassword) { %>
                        <span class="error-text">
                            <%= errors.oldPassword %>
                        </span>
                        <% } %>
                </div>
                <% } %>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <div class="password-toggle-group">
                        <input type="password" name="newPassword" id="newPassword"
                            value="<%= typeof newPassword !== 'undefined' ? newPassword : '' %>">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('newPassword', this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div id="newPasswordError" class="error-text" style="display: none;"></div>
                    <% if (typeof errors !=='undefined' && errors.newPassword) { %>
                        <span class="error-text">
                            <%= errors.newPassword %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <div class="password-toggle-group">
                        <input type="password" name="confirmPassword" id="confirmPassword"
                            value="<%= typeof confirmPassword !== 'undefined' ? confirmPassword : '' %>">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('confirmPassword', this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div id="confirmPasswordError" class="error-text" style="display: none;"></div>
                    <% if (typeof errors !=='undefined' && errors.confirmPassword) { %>
                        <span class="error-text">
                            <%= errors.confirmPassword %>
                        </span>
                        <% } %>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn"><%= user.password ? 'Update Password' : 'Set Password' %></button>
                <a href="/profile/edit" class="back-btn">Go Back</a>
            </form>
        </div>
    </div>
    <script src="/js/notifications.js"></script>
    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const oldPassword = document.getElementById('oldPassword')?.value;
            const newPassword = document.getElementById('newPassword')?.value;
            const confirmPassword = document.getElementById('confirmPassword')?.value;
            const submitBtn = document.getElementById('submitBtn');

            // Clear previous errors
            document.querySelectorAll('.error-text').forEach(el => {
                el.textContent = '';
                el.style.display = 'none';
            });
            document.querySelectorAll('input').forEach(input => input.style.borderColor = '#000');

            let hasErrors = false;

            const oldPasswordInput = document.getElementById('oldPassword');
            if (oldPasswordInput && !oldPassword) {
                showFieldError('oldPassword', 'Blank field');
                hasErrors = true;
            }

            if (!newPassword) {
                showFieldError('newPassword', 'Blank field');
                hasErrors = true;
            } else {
                const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/;
                if (!passwordRegex.test(newPassword)) {
                    showFieldError('newPassword', 'Password must contain uppercase, lowercase, number and symbol (min 8 characters).');
                    hasErrors = true;
                }
            }

            if (!confirmPassword) {
                showFieldError('confirmPassword', 'Blank field');
                hasErrors = true;
            } else if (newPassword !== confirmPassword) {
                showFieldError('confirmPassword', 'Passwords do not match');
                hasErrors = true;
            }

            if (hasErrors) return;

            const originalText = submitBtn.textContent;
            const card = document.querySelector('.card');
            
            card.classList.add('is-loading-container');
            submitBtn.textContent = 'Updating...';
            submitBtn.disabled = true;
            submitBtn.classList.add('btn-loading');

            try {
                // Use minDelay (600ms) to ensure shimmer visibility
                const [response] = await Promise.all([
                    fetch('/api/users/profile/password', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ oldPassword, newPassword, confirmPassword })
                    }),
                    new Promise(resolve => setTimeout(resolve, 600))
                ]);

                const data = await response.json();

                if (data.success) {
                    KavoxNotify.alert({
                        icon: 'success',
                        title: 'Success!',
                        text: data.message
                    }).then(() => {
                        window.location.href = '/account';
                    });
                } else {
                    card.classList.remove('is-loading-container');
                    submitBtn.textContent = originalText;
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('btn-loading');

                    if (data.errors) {
                        for (const [field, message] of Object.entries(data.errors)) {
                            showFieldError(field, message);
                        }
                    } else {
                        const generalError = document.getElementById('generalError');
                        generalError.textContent = data.message || 'Validation failed.';
                        generalError.style.display = 'block';
                    }
                }
            } catch (error) {
                card.classList.remove('is-loading-container');
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
                submitBtn.classList.remove('btn-loading');
                
                console.error("Error:", error);
                const generalError = document.getElementById('generalError');
                generalError.textContent = 'Something went wrong or invalid password';
                generalError.style.display = 'block';
            }
        });

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('svg');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        function showFieldError(fieldId, message) {
            const errorElement = document.getElementById(fieldId + 'Error');
            if (errorElement) {
                errorElement.textContent = message;
                errorElement.style.display = 'block';
            }
            document.getElementById(fieldId).style.borderColor = '#e91e63';
        }
    </script>
    <%- include('../partials/user-footer') %>
</body>
</html>