<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - KAVOX SOLE LAB...!!!!!!!!!!</title>
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.all.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header Styles */
        .header {
            background-color: #1a1a1a;
            padding: 12px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            width: 100%;
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .logo-img {
            height: 30px;
            filter: invert(0);
        }

        .logo-sub {
            font-size: 12px;
            color: #4ade80;
            letter-spacing: 6.5px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .nav-links a:hover {
            color: #4ade80;
        }

        .header-icons {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .header-icons a {
            color: #fff;
            display: flex;
            align-items: center;
        }

        .header-icons svg {
            width: 22px;
            height: 22px;
        }

        .sign-in-btn {
            background-color: #e91e63;
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
        }

        .sign-in-btn:hover {
            background-color: #c2185b;
        }

        .profile-mini {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background-color: #333;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #4ade80;
        }

        .profile-mini img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        /* Main Content */
        .main-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .card {
            border: 2px solid #000000;
            border-radius: 4px;
            padding: 40px 60px;
            width: 100%;
            max-width: 550px;
            text-align: center;
        }

        .card-logo {
            margin-bottom: 25px;
        }

        .card-logo img {
            height: 40px;
        }

        .card-logo .subtitle {
            font-size: 10px;
            letter-spacing: 8px;
            color: #000;
            font-weight: 600;
            margin-top: 5px;
            text-indent: 8px;
        }

        .title {
            font-size: 28px;
            font-weight: 700;
            color: #000000;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1.5px solid #000000;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            border-color: #e91e63;
            box-shadow: 0 0 5px rgba(233, 30, 99, 0.2);
        }

        .password-toggle-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            cursor: pointer;
            color: #666;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            padding: 0;
            outline: none;
            transition: color 0.2s;
        }

        .toggle-password:hover {
            color: #333;
        }

        .toggle-password svg {
            width: 18px;
            height: 18px;
        }

        .error-text {
            color: #e91e63;
            font-size: 11px;
            margin-top: 5px;
            font-weight: 500;
            display: block;
        }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background-color: #000000;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .submit-btn:hover {
            background-color: #333;
            transform: translateY(-1px);
        }

        @media (max-width: 480px) {
            .card {
                padding: 30px 20px;
                border: 1px solid #000;
            }

            .header {
                padding: 10px 15px;
            }
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="header">
        <div class="logo-container">
            <img src="/images/logo.png" alt="KAVOX" class="logo-img">
            <span class="logo-sub">SOLE LAB</span>
        </div>

        <nav class="nav-links">
            <a href="/">HOME</a>
            <a href="/shop">SHOP</a>
            <a href="/orders">ORDERS</a>
        </nav>

        <div class="header-icons">
            <a href="/cart" title="Cart">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                </svg>
            </a>
            <a href="/wishlist" title="Wishlist">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                    </path>
                </svg>
            </a>
            <% if (locals.user) { %>
                <a href="/account" title="Account">
                    <div class="profile-mini">
                        <% if (user.profileImage && user.profileImage !=="/images/default-user.png" ) { %>
                            <img src="<%= user.profileImage %>" alt="Profile">
                            <% } else { %>
                                <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                                    <% } %>
                    </div>
                </a>
                <a href="/api/auth/logout" class="sign-in-btn" style="background-color: #333;">Logout</a>
                <% } else { %>
                    <a href="/login" class="sign-in-btn">Sign In</a>
                    <% } %>
        </div>
    </header>

    <div class="main-container">
        <div class="card">
            <div class="card-logo">
                <img src="/images/logo.png" alt="KAVOX">
                <div class="subtitle">S O L E &nbsp;&nbsp; L A B</div>
            </div>

            <h1 class="title">Reset Password</h1>

            <form id="resetPasswordForm" action="/profile/reset-password" method="POST">
                <div class="form-group">
                    <label for="oldPassword">Old Password</label>
                    <div class="password-toggle-group">
                        <input type="password" name="oldPassword" id="oldPassword"
                            value="<%= typeof oldPassword !== 'undefined' ? oldPassword : '' %>">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('oldPassword', this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div id="oldPasswordError" class="error-text" style="display: none;"></div>
                    <% if (typeof errors !=='undefined' && errors.oldPassword) { %>
                        <span class="error-text">
                            <%= errors.oldPassword %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <div class="password-toggle-group">
                        <input type="password" name="newPassword" id="newPassword"
                            value="<%= typeof newPassword !== 'undefined' ? newPassword : '' %>">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('newPassword', this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div id="newPasswordError" class="error-text" style="display: none;"></div>
                    <% if (typeof errors !=='undefined' && errors.newPassword) { %>
                        <span class="error-text">
                            <%= errors.newPassword %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <div class="password-toggle-group">
                        <input type="password" name="confirmPassword" id="confirmPassword"
                            value="<%= typeof confirmPassword !== 'undefined' ? confirmPassword : '' %>">
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility('confirmPassword', this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div id="confirmPasswordError" class="error-text" style="display: none;"></div>
                    <% if (typeof errors !=='undefined' && errors.confirmPassword) { %>
                        <span class="error-text">
                            <%= errors.confirmPassword %>
                        </span>
                        <% } %>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">Update Password</button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const submitBtn = document.getElementById('submitBtn');

            // Clear previous errors
            document.querySelectorAll('.error-text').forEach(el => {
                el.textContent = '';
                el.style.display = 'none';
            });
            document.querySelectorAll('input').forEach(input => input.style.borderColor = '#000');

            let hasErrors = false;

            if (!oldPassword) {
                showFieldError('oldPassword', 'Old password is required');
                hasErrors = true;
            }

            if (!newPassword) {
                showFieldError('newPassword', 'New password is required');
                hasErrors = true;
            } else {
                const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/;
                if (!passwordRegex.test(newPassword)) {
                    showFieldError('newPassword', 'Password must contain uppercase, lowercase, number and symbol (min 8 characters).');
                    hasErrors = true;
                }
            }

            if (!confirmPassword) {
                showFieldError('confirmPassword', 'Please confirm your new password');
                hasErrors = true;
            } else if (newPassword !== confirmPassword) {
                showFieldError('confirmPassword', 'Passwords do not match');
                hasErrors = true;
            }

            if (hasErrors) return;

            const originalText = submitBtn.textContent;
            submitBtn.textContent = 'Updating...';
            submitBtn.disabled = true;

            try {
                const response = await fetch('/profile/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPassword, newPassword, confirmPassword })
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: data.message,
                        confirmButtonColor: '#000'
                    }).then(() => {
                        window.location.href = '/account';
                    });
                } else if (data.errors) {
                    // Show field level errors
                    for (const [field, message] of Object.entries(data.errors)) {
                        showFieldError(field, message);
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed',
                        text: data.message || 'Validation failed.',
                        confirmButtonColor: '#000'
                    });
                }
            } catch (error) {
                console.error("Error:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong or invalid password',
                    confirmButtonColor: '#000'
                });
            } finally {
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }
        });

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('svg');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        function showFieldError(fieldId, message) {
            const errorElement = document.getElementById(fieldId + 'Error');
            if (errorElement) {
                errorElement.textContent = message;
                errorElement.style.display = 'block';
            }
            document.getElementById(fieldId).style.borderColor = '#e91e63';
        }
    </script>
</body>

</html>